+extern "C" __global__ void __launch_bounds__(128) tf_dsv41_prefill_epi_bf16(
+    const float* __restrict__ in, const half* __restrict__ svh, __nv_bfloat16* __restrict__ out,
+    int M, int N, int os) {
+    const int blk = blockIdx.x * 4 + (threadIdx.x >> 5);
+    const int row = blockIdx.y;
+    const int lane = threadIdx.x & 31;
+    if (blk >= (N >> 7) || row >= M) return;
+    const int col = blk * 128 + lane * 4;
+    const float4 z = *reinterpret_cast<const float4*>(in + (size_t)row * N + col);
+    float v[4] = {z.x, z.y, z.z, z.w};
+    tf_dsv41_sm110a::fwht128(v, lane);
+    const half2* sv = reinterpret_cast<const half2*>(svh + col);
+    const float2 s0 = __half22float2(sv[0]), s1 = __half22float2(sv[1]);
+    const __nv_bfloat162 o0 = __floats2bfloat162_rn(v[0] * tf_dsv41_sm110a::HAD_SCALE * s0.x, v[1] * tf_dsv41_sm110a::HAD_SCALE * s0.y);
+    const __nv_bfloat162 o1 = __floats2bfloat162_rn(v[2] * tf_dsv41_sm110a::HAD_SCALE * s1.x, v[3] * tf_dsv41_sm110a::HAD_SCALE * s1.y);
+    uint2 u;
+    u.x = *reinterpret_cast<const uint32_t*>(&o0);
+    u.y = *reinterpret_cast<const uint32_t*>(&o1);
+    *reinterpret_cast<uint2*>(out + (size_t)row * os + col) = u;
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_dsv41_prefill_epi_f32(
+    const float* __restrict__ in, const half* __restrict__ svh, float* __restrict__ out,
+    int M, int N, int os) {
+    const int blk = blockIdx.x * 4 + (threadIdx.x >> 5);
+    const int row = blockIdx.y;
+    const int lane = threadIdx.x & 31;
+    if (blk >= (N >> 7) || row >= M) return;
+    const int col = blk * 128 + lane * 4;
+    const float4 z = *reinterpret_cast<const float4*>(in + (size_t)row * N + col);
+    float v[4] = {z.x, z.y, z.z, z.w};
+    tf_dsv41_sm110a::fwht128(v, lane);
+    const half2* sv = reinterpret_cast<const half2*>(svh + col);
+    const float2 s0 = __half22float2(sv[0]), s1 = __half22float2(sv[1]);
+    *reinterpret_cast<float4*>(out + (size_t)row * os + col) = make_float4(
+        v[0] * tf_dsv41_sm110a::HAD_SCALE * s0.x, v[1] * tf_dsv41_sm110a::HAD_SCALE * s0.y,
+        v[2] * tf_dsv41_sm110a::HAD_SCALE * s1.x, v[3] * tf_dsv41_sm110a::HAD_SCALE * s1.y);
+}
+
+extern "C" __global__ void __launch_bounds__(1024) tf_dsv41_shard_local(
+    const float* __restrict__ logits, unsigned long long ld, int n, int first, float4* __restrict__ out) {
+    const float* row = logits + (unsigned long long)blockIdx.x * ld;
+    const float ninf = -__int_as_float(0x7f800000);
+    float bv = ninf;
+    int bi = 0x7fffffff;
+    if ((((uintptr_t)row) & 15u) == 0u) {
+        const int n4 = n >> 2;
+        const float4* row4 = reinterpret_cast<const float4*>(row);
+        for (int i4 = threadIdx.x; i4 < n4; i4 += blockDim.x) {
+            const float4 v4 = __ldcv(row4 + i4);
+            const int base = i4 << 2;
+            tf_dsv41_sm110a::upd_best(v4.x, base + 0, bv, bi);
+            tf_dsv41_sm110a::upd_best(v4.y, base + 1, bv, bi);
+            tf_dsv41_sm110a::upd_best(v4.z, base + 2, bv, bi);
+            tf_dsv41_sm110a::upd_best(v4.w, base + 3, bv, bi);
+        }
+        for (int i = (n4 << 2) + threadIdx.x; i < n; i += blockDim.x)
+            tf_dsv41_sm110a::upd_best(__ldcv(row + i), i, bv, bi);
+    } else {
+        for (int i = threadIdx.x; i < n; i += blockDim.x)
+            tf_dsv41_sm110a::upd_best(__ldcv(row + i), i, bv, bi);
+    }
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        const float ov = __shfl_down_sync(0xffffffffu, bv, off);
+        const int oi = __shfl_down_sync(0xffffffffu, bi, off);
+        if (ov > bv || (ov == bv && oi < bi)) { bv = ov; bi = oi; }
+    }
+    __shared__ float sv[32];
+    __shared__ int si[32];
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    if (lane == 0) { sv[warp] = bv; si[warp] = bi; }
+    __syncthreads();
+    if (warp != 0) return;
+    const int nw = (blockDim.x + 31) >> 5;
+    bv = lane < nw ? sv[lane] : ninf;
+    bi = lane < nw ? si[lane] : 0x7fffffff;
+#pragma unroll
+    for (int off = 16; off > 0; off >>= 1) {
+        const float ov = __shfl_down_sync(0xffffffffu, bv, off);
+        const int oi = __shfl_down_sync(0xffffffffu, bi, off);
+        if (ov > bv || (ov == bv && oi < bi)) { bv = ov; bi = oi; }
+    }
+    if (lane == 0) out[blockIdx.x] = make_float4(bv, __int_as_float(bi == 0x7fffffff ? bi : first + bi), row[0], 0.f);
+}
+
+extern "C" __global__ void tf_dsv41_shard_pick(
+    const float4* __restrict__ gathered, int rows, int world, unsigned* __restrict__ out) {
+    const int r = threadIdx.x;
+    if (r >= rows) return;
+    float4 best = gathered[r];
+    int bi = __float_as_int(best.y);
+    for (int k = 1; k < world; ++k) {
+        const float4 v = gathered[k * rows + r];
+        const int vi = __float_as_int(v.y);
+        if (v.x > best.x || (v.x == best.x && vi < bi)) { best = v; bi = vi; }
+    }
+    const float first = gathered[r].z;
+    out[r] = (first != first) ? 0u : (unsigned)bi;
+}
