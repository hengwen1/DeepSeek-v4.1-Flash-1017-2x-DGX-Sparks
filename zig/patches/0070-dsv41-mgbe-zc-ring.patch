diff --git a/zig/src/families/dsv41/mgbe_zc.zig b/zig/src/families/dsv41/mgbe_zc.zig
new file mode 100644
index 0000000..b35aa6a
--- /dev/null
+++ b/zig/src/families/dsv41/mgbe_zc.zig
@@ -0,0 +1,2013 @@
+//! Two-rank TP all-gather & sized row exchange over /dev/mgbe_zc (4x25GbE zero-copy MGBE on Jetson AGX Thor),
+//! plugged behind dsv41/rdma.Ring so dsv41_rdma.cu (stage/collect/collect_into) and dsv41_shard.cu
+//! (tf_ds_ring_stage_rows/collect_rows) run unchanged with full CUDA-Graph and PDL support.
+//!
+//! Uses a single CUDA VMM CU_MEM_LOCATION_TYPE_HOST_NUMA region (holding send, recv, and meta) registered once across
+//! all active MGBE ports for contiguous 48-bit SMMU IOVA:
+//!   - Small stripes (<= TF_MGBE_ZC_EAGER_KB, default 32 KiB/rail): 0.5-RTT raw L2 eager frames on VDMA 2 (0x88B5)
+//!     with zero handshake (~4-6 us 1-way wire latency for decode/verify gathers).
+//!   - Bulk stripes (> TF_MGBE_ZC_EAGER_KB, up to TF_MGBE_ZC_MAX_KB default 20 MiB/rank): hardware split-header
+//!     DDP (SPH=1, 64B header + 8192B payload) directly into recv[slot][peer] SMMU IOVA on VDMA 3 (0x88B6) with
+//!     RTS/CTS/ACK and Go-Back-N retransmit (~90 Gbps across 4 rails for prefill gathers).
+//!   - Asymmetric TX/RX sizes (including 0-byte sides for TF_DS_KV_SHARD sendRows/recvRows) are handled natively per
+//!     direction: eager TX carries peer's exact nbytes in the header, bulk TX announces nbytes via RTS.
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const abi = cuda.abi;
+const Driver = cuda.Driver;
+const uapi = cuda.mgbe_zc_uapi;
+
+pub const max_ports = uapi.max_ports;
+pub const default_slots: u32 = 2;
+const max_slots: usize = 16;
+const flag_retrans: u8 = 1;
+
+const hdr_bytes: usize = 64;
+const max_payload: usize = 8192;
+const ctrl_rx_stride: usize = 9216; // holds full 64B hdr + 8192B eager jumbo frame (64B aligned)
+const data_rx_stride: usize = 256; // SPH=1 splits 64B header here; 8192B payload lands directly in CUDA HOST_NUMA
+const tx_batch_pkts: u32 = 16;
+const bulk_win_max_pkts: u32 = 512; // 4 MiB per DDP window (fits multiple recovery postings inside 4096-desc ring)
+const wire_magic: u32 = 0x5A433247; // 'ZC2G'
+const pr_set_name: c_int = 15;
+const pr_set_timerslack: c_int = 29;
+
+extern "c" fn prctl(option: c_int, arg2: c_ulong, arg3: c_ulong, arg4: c_ulong, arg5: c_ulong) c_int;
+
+// Per-port anonymous mmap pool layout (40 MiB):
+//   [0 .. 256 KiB)              ctrl_q TX headers  (4096 * 64B)
+//   [256 KiB .. 512 KiB)        data_q TX headers  (4096 * 64B)
+//   [512 KiB .. 1536 KiB)       data_q RX headers  (4096 * 256B)
+//   [2 MiB .. 38 MiB)           ctrl_q RX buffers  (4096 * 9216B)
+const port_pool_bytes: usize = 40 << 20;
+const ctrl_tx_off: usize = 0;
+const data_tx_off: usize = 256 << 10;
+const data_rx_off: usize = 512 << 10;
+const ctrl_rx_off: usize = 2 << 20;
+
+const Op = enum(u8) {
+    probe = 0x01,
+    probe_ack = 0x02,
+    eager = 0x10,
+    rts = 0x11,
+    cts = 0x12,
+    bulk_data = 0x13,
+    ack = 0x14,
+    nack = 0x15,
+    ack_req = 0x16,
+    eager_req = 0x17,
+};
+
+const WireHdr = extern struct {
+    dst_mac: [6]u8 = @splat(0), // 0..5
+    src_mac: [6]u8 = @splat(0), // 6..11
+    ethertype_be: u16 = 0, // 12..13
+    opcode: u8 = 0, // 14
+    flags: u8 = 0, // 15
+    win_pkts: u16 = 0, // 16..17
+    total_pkts: u16 = 0, // 18..19
+    seq: u32 = 0, // 20..23
+    psn: u32 = 0, // 24..27
+    payload_len: u32 = 0, // 28..31
+    nbytes: u32 = 0, // 32..35
+    win_start: u32 = 0, // 36..39
+    cts_gen: u32 = 0, // 40..43
+    pad: [16]u8 = @splat(0), // 44..59
+    magic: u32 = wire_magic, // 60..63
+};
+
+comptime {
+    std.debug.assert(@sizeOf(WireHdr) == hdr_bytes);
+}
+
+pub const Error = error{
+    UnsupportedPlatform,
+    VmmUnavailable,
+    DeviceUnavailable,
+    NoPorts,
+    IoctlFailed,
+    MmapFailed,
+    MrFailed,
+    ProbeFailed,
+    PeerRefused,
+    ProxyFailed,
+    BadLayout,
+};
+
+/// Single-region geometry for dsv41/rdma.Ring (world = 2): send[slots][slot_bytes], recv[slots][2][slot_bytes],
+/// meta(flags[slots][2], doorbell, sizes[slots], sent[slots], abort_word). Each section is page-aligned so it maps
+/// straight into Ring.send / Ring.recv / Ring.meta.
+pub const Layout = struct {
+    slots: u32,
+    slot_bytes: usize,
+    send_off: usize,
+    send_len: usize,
+    recv_off: usize,
+    recv_len: usize,
+    meta_off: usize,
+    meta_len: usize,
+    total: usize,
+
+    pub const section_align: usize = @max(@as(usize, 4096), std.heap.page_size_min);
+
+    pub fn of(slots: u32, max_bytes: usize) Error!Layout {
+        if (slots < 2 or slots > max_slots or !std.math.isPowerOfTwo(slots)) return error.BadLayout;
+        const sb = std.mem.alignForward(usize, @max(max_bytes, 4096), 4096);
+        const send_len = std.mem.alignForward(usize, @as(usize, slots) * sb, section_align);
+        const recv_off = send_len;
+        const recv_len = std.mem.alignForward(usize, @as(usize, slots) * 2 * sb, section_align);
+        const meta_off = recv_off + recv_len;
+        const meta_words = @as(usize, slots) * 2 + 1 + 2 * @as(usize, slots) + 1;
+        const meta_len = std.mem.alignForward(usize, meta_words * 8, section_align);
+        return .{
+            .slots = slots,
+            .slot_bytes = sb,
+            .send_off = 0,
+            .send_len = send_len,
+            .recv_off = recv_off,
+            .recv_len = recv_len,
+            .meta_off = meta_off,
+            .meta_len = meta_len,
+            .total = meta_off + meta_len,
+        };
+    }
+
+    pub fn sendAt(l: Layout, slot: usize) usize {
+        return l.send_off + slot * l.slot_bytes;
+    }
+
+    pub fn recvAt(l: Layout, slot: usize, from_rank: usize) usize {
+        return l.recv_off + (slot * 2 + from_rank) * l.slot_bytes;
+    }
+};
+
+/// Peer rendezvous record exchanged over NCCL (or TCP in rdma_bench_main).
+pub const Info = extern struct {
+    ok: u32 = 0,
+    n_ports: u32 = 0,
+    slot_bytes: u64 = 0,
+    max_bytes: u64 = 0,
+    port_ids: [max_ports]u32 = @splat(0),
+    macs: [max_ports][6]u8 = @splat(@splat(0)),
+};
+
+/// TF_MGBE_ZC: 0/off disables; 1/on/unset attempts on TP=2 Linux when /dev/mgbe_zc exists.
+pub fn wanted(world: u32) bool {
+    if (comptime builtin.os.tag != .linux) return false;
+    if (world != 2) return false;
+    const v = std.c.getenv("TF_MGBE_ZC") orelse return true;
+    const s = std.mem.span(v);
+    return !(std.mem.eql(u8, s, "0") or std.mem.eql(u8, s, "off"));
+}
+
+fn debugOn() bool {
+    const v = std.c.getenv("TF_MGBE_ZC_DEBUG") orelse return false;
+    const s = std.mem.span(v);
+    return s.len > 0 and !std.mem.eql(u8, s, "0");
+}
+
+fn envUsize(name: [:0]const u8, default: usize) usize {
+    const v = std.c.getenv(name) orelse return default;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default;
+}
+
+/// TF_MGBE_ZC_MAX_KB in bytes (default 20 MiB per rank: fits a full 2048-row attention/MoE prefill chunk in one op).
+pub fn maxBytesFromEnv() usize {
+    const kb = envUsize("TF_MGBE_ZC_MAX_KB", 20480);
+    const clamped: usize = @min(kb, 65536);
+    return @max(@as(usize, 64 << 10), clamped << 10);
+}
+
+fn eagerMaxBytesFromEnv() usize {
+    const kb = envUsize("TF_MGBE_ZC_EAGER_KB", 32);
+    const clamped: usize = @min(kb, 128);
+    return clamped << 10; // up to 16 jumbo packets per rail (mask fits u32)
+}
+
+fn timeoutNsFromEnv() u64 {
+    const s = envUsize("TF_MGBE_ZC_TIMEOUT_S", 15);
+    return @as(u64, @max(s, 2)) * 1_000_000_000;
+}
+
+fn arrivalTimeoutNsFromEnv(xfer_ns: u64) u64 {
+    const s = envUsize("TF_MGBE_ZC_ARRIVAL_TIMEOUT_S", 90);
+    return @max(xfer_ns, @as(u64, @max(s, 2)) * 1_000_000_000);
+}
+
+inline fn nowNs() u64 {
+    var ts: std.c.timespec = undefined;
+    _ = std.c.clock_gettime(.MONOTONIC, &ts);
+    return @as(u64, @intCast(ts.sec)) * 1_000_000_000 + @as(u64, @intCast(ts.nsec));
+}
+
+fn nap(ns: u64) void {
+    const ts: std.c.timespec = .{ .sec = @intCast(ns / std.time.ns_per_s), .nsec = @intCast(ns % std.time.ns_per_s) };
+    _ = std.c.nanosleep(&ts, null);
+}
+
+inline fn dmbOshst() void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        asm volatile ("dmb oshst" ::: .{ .memory = true });
+    }
+}
+
+inline fn dsbSy() void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        asm volatile ("dsb sy" ::: .{ .memory = true });
+    }
+}
+
+inline fn mmioWrite32(base: [*]volatile u8, off: usize, val: u32) void {
+    dmbOshst();
+    const p: *volatile u32 = @ptrCast(@alignCast(base + off));
+    p.* = val;
+}
+
+inline fn mmioRead32(base: [*]volatile u8, off: usize) u32 {
+    const p: *volatile u32 = @ptrCast(@alignCast(base + off));
+    return p.*;
+}
+
+inline fn cacheCleanRange(ptr: [*]const u8, len: usize) void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        if (len == 0) return;
+        var a: usize = @intFromPtr(ptr) & ~@as(usize, 63);
+        const end: usize = @intFromPtr(ptr) + len;
+        while (a < end) : (a += 64) {
+            asm volatile ("dc cvac, %[a]"
+                :
+                : [a] "r" (a),
+                : .{ .memory = true });
+        }
+        asm volatile ("dsb sy" ::: .{ .memory = true });
+    }
+}
+
+inline fn cacheInvalRange(ptr: [*]const u8, len: usize) void {
+    if (comptime builtin.cpu.arch == .aarch64) {
+        if (len == 0) return;
+        var a: usize = @intFromPtr(ptr) & ~@as(usize, 63);
+        const end: usize = @intFromPtr(ptr) + len;
+        while (a < end) : (a += 64) {
+            asm volatile ("dc civac, %[a]"
+                :
+                : [a] "r" (a),
+                : .{ .memory = true });
+        }
+        asm volatile ("dsb sy\n\tisb" ::: .{ .memory = true });
+    }
+}
+
+fn placeRailWorker(rail_idx: usize, cpu: i32) void {
+    if (comptime builtin.os.tag != .linux) return;
+    var name: [16]u8 = @splat(0);
+    _ = std.fmt.bufPrint(name[0..15], "tf-mgbe-zc-{d}", .{rail_idx}) catch {};
+    _ = prctl(pr_set_name, @intFromPtr(&name), 0, 0, 0);
+    if (cpu < 0 or cpu >= 1024) return;
+    var set: std.os.linux.cpu_set_t = @splat(0);
+    const bits = @bitSizeOf(usize);
+    const idx: usize = @intCast(@divTrunc(cpu, bits));
+    const bit: usize = @intCast(@mod(cpu, bits));
+    if (idx < set.len) {
+        set[idx] = @as(usize, 1) << @intCast(bit);
+        std.os.linux.sched_setaffinity(0, &set) catch {};
+    }
+}
+
+fn ioctlCall(fd: i32, req: u32, arg: usize) Error!void {
+    if (comptime builtin.os.tag != .linux) return error.UnsupportedPlatform;
+    const rc = std.os.linux.ioctl(fd, req, arg);
+    if (@as(isize, @bitCast(rc)) < 0) return error.IoctlFailed;
+}
+
+fn mmapFile(fd: i32, len: usize, off: u64) Error![*]align(4096) u8 {
+    if (comptime builtin.os.tag != .linux) return error.UnsupportedPlatform;
+    const rc = std.os.linux.mmap(null, len, .{ .READ = true, .WRITE = true }, .{ .TYPE = .SHARED }, fd, @intCast(off));
+    const addr: isize = @bitCast(rc);
+    if (addr < 0) return error.MmapFailed;
+    return @ptrFromInt(rc);
+}
+
+fn mmapAnon(len: usize) Error![*]align(4096) u8 {
+    if (comptime builtin.os.tag != .linux) return error.UnsupportedPlatform;
+    const rc = std.os.linux.mmap(null, len, .{ .READ = true, .WRITE = true }, .{ .TYPE = .PRIVATE, .ANONYMOUS = true, .POPULATE = true }, -1, 0);
+    const addr: isize = @bitCast(rc);
+    if (addr < 0) return error.MmapFailed;
+    return @ptrFromInt(rc);
+}
+
+fn munmapPtr(ptr: [*]align(4096) u8, len: usize) void {
+    if (comptime builtin.os.tag != .linux) return;
+    _ = std.os.linux.munmap(ptr, len);
+}
+
+fn closeFd(fd: i32) void {
+    if (comptime builtin.os.tag != .linux) return;
+    _ = std.os.linux.close(fd);
+}
+
+fn ioctlIgnore(fd: i32, req: u32, arg: usize) void {
+    if (comptime builtin.os.tag != .linux) return;
+    _ = std.os.linux.ioctl(fd, req, arg);
+}
