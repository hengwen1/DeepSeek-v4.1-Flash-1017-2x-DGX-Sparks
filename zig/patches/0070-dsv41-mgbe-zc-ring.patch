+/// CUDA VMM HOST_NUMA buffer: directly accessible by both GPU kernels and /dev/mgbe_zc FOLL_LONGTERM SMMU DMA.
+pub const HostNumaRegion = struct {
+    d: *const Driver,
+    vmm: abi.VmmApi,
+    handle: u64 = 0,
+    va: u64 = 0,
+    size: usize = 0,
+
+    pub fn alloc(d: *const Driver, req_bytes: usize) !HostNumaRegion {
+        const vmm = d.vmm orelse return error.VmmUnavailable;
+        var dev: abi.Device = 0;
+        try d.check(vmm.cuCtxGetDevice(&dev), "cuCtxGetDevice");
+        var prop: abi.MemAllocationProp = .{
+            .type = abi.cu_mem_allocation_type_pinned,
+            .location = .{ .type = abi.cu_mem_location_type_host_numa, .id = 0 },
+        };
+        var gran: usize = 0;
+        try d.check(vmm.cuMemGetAllocationGranularity(&gran, &prop, abi.cu_mem_alloc_granularity_minimum), "cuMemGetAllocationGranularity");
+        if (gran == 0) return error.VmmUnavailable;
+        const sz = std.mem.alignForward(usize, req_bytes, @max(gran, Layout.section_align));
+        var handle: u64 = 0;
+        try d.check(vmm.cuMemCreate(&handle, sz, &prop, 0), "cuMemCreate(HOST_NUMA)");
+        errdefer _ = vmm.cuMemRelease(handle);
+        var va: u64 = 0;
+        try d.check(vmm.cuMemAddressReserve(&va, sz, @max(gran, Layout.section_align), 0, 0), "cuMemAddressReserve");
+        errdefer _ = vmm.cuMemAddressFree(va, sz);
+        try d.check(vmm.cuMemMap(va, sz, 0, handle, 0), "cuMemMap");
+        errdefer _ = vmm.cuMemUnmap(va, sz);
+        var acc = [2]abi.MemAccessDesc{
+            .{ .location = .{ .type = abi.cu_mem_location_type_device, .id = dev }, .flags = abi.cu_mem_access_flags_prot_readwrite },
+            .{ .location = .{ .type = abi.cu_mem_location_type_host_numa, .id = 0 }, .flags = abi.cu_mem_access_flags_prot_readwrite },
+        };
+        try d.check(vmm.cuMemSetAccess(va, sz, &acc, 2), "cuMemSetAccess");
+        const bytes: [*]u8 = @ptrFromInt(va);
+        @memset(bytes[0..sz], 0);
+        return .{ .d = d, .vmm = vmm, .handle = handle, .va = va, .size = sz };
+    }
+
+    pub fn ptr(r: HostNumaRegion) [*]align(Layout.section_align) u8 {
+        return @ptrFromInt(r.va);
+    }
+
+    pub fn free(r: *HostNumaRegion) void {
+        if (r.va != 0) {
+            _ = r.vmm.cuMemUnmap(r.va, r.size);
+            _ = r.vmm.cuMemAddressFree(r.va, r.size);
+            _ = r.vmm.cuMemRelease(r.handle);
+        }
+        r.* = undefined;
+        r.va = 0;
+    }
+};
+
+const Queue = struct {
+    port: u32 = 0,
+    qidx: u32 = 0,
+    hw_chan: u32 = 0,
+    tx_ring_iova: u64 = 0,
+    rx_ring_iova: u64 = 0,
+    tx_ring: ?[*]align(4096) uapi.HwDesc = null,
+    rx_ring: ?[*]align(4096) uapi.HwDesc = null,
+    reg_page: ?[*]align(4096) u8 = null,
+    ch_reg: [*]volatile u8 = undefined,
+    tx_prod: u32 = 0,
+    tx_cons: u32 = 0,
+    rx_prod: u32 = 0,
+    rx_cons: u32 = 0,
+    tx_hdr_va: [*]u8 = undefined,
+    tx_hdr_iova: u64 = 0,
+    rx_buf_va: [*]u8 = undefined,
+    rx_buf_iova: u64 = 0,
+    rx_stride: usize = 0,
+    started: bool = false,
+    tx_desc_cnt: [uapi.ring_desc_cnt]u8 = @splat(0),
+
+    fn setup(q: *Queue, fd: i32, port: u32, qidx: u32, sph: bool, tx_va: [*]u8, tx_iova: u64, rx_va: [*]u8, rx_iova: u64, rx_stride: usize) Error!void {
+        q.* = .{
+            .port = port,
+            .qidx = qidx,
+            .tx_hdr_va = tx_va,
+            .tx_hdr_iova = tx_iova,
+            .rx_buf_va = rx_va,
+            .rx_buf_iova = rx_iova,
+            .rx_stride = rx_stride,
+        };
+        var qa: uapi.QueueAlloc = .{ .port = port, .qidx = qidx };
+        try ioctlCall(fd, uapi.ioc_queue_alloc, @intFromPtr(&qa));
+        q.hw_chan = qa.hw_chan;
+        q.tx_ring_iova = qa.tx_ring_iova;
+        q.rx_ring_iova = qa.rx_ring_iova;
+        q.tx_ring = @ptrCast(try mmapFile(fd, uapi.ring_bytes, qa.mmap_tx_off));
+        errdefer if (q.tx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.rx_ring = @ptrCast(try mmapFile(fd, uapi.ring_bytes, qa.mmap_rx_off));
+        errdefer if (q.rx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.reg_page = try mmapFile(fd, uapi.reg_map_bytes, qa.mmap_reg_off);
+        errdefer if (q.reg_page) |p| munmapPtr(p, uapi.reg_map_bytes);
+        q.ch_reg = @as([*]volatile u8, @ptrCast(q.reg_page.?)) + qa.ch_reg_off;
+
+        var init_tail: u32 = 0;
+        if (!sph) {
+            const rx = q.rx_ring.?;
+            for (0..uapi.ring_desc_cnt - 1) |i| {
+                const b = rx_iova + @as(u64, i) * rx_stride;
+                rx[i] = .{
+                    .d0 = @truncate(b),
+                    .d1 = @truncate(b >> 32),
+                    .d2 = 0,
+                    .d3 = uapi.desc_own,
+                };
+            }
+            rx[uapi.ring_desc_cnt - 1].d3 = 0;
+            q.rx_prod = uapi.ring_desc_cnt - 1;
+            q.rx_cons = 0;
+            init_tail = uapi.ring_desc_cnt - 1;
+        }
+        dsbSy();
+        var qs: uapi.QueueStart = .{
+            .port = port,
+            .qidx = qidx,
+            .rx_buf_size = 9216,
+            .sph_enable = if (sph) 1 else 0,
+            .sph_split_bytes = if (sph) hdr_bytes else 0,
+            .init_rx_tail_idx = init_tail,
+        };
+        try ioctlCall(fd, uapi.ioc_queue_start, @intFromPtr(&qs));
+        q.started = true;
+    }
+
+    fn teardown(q: *Queue, fd: i32) void {
+        if (q.started and fd >= 0) {
+            var qst: uapi.QueueStop = .{ .port = q.port, .qidx = q.qidx };
+            ioctlIgnore(fd, uapi.ioc_queue_stop, @intFromPtr(&qst));
+            q.started = false;
+        }
+        if (q.reg_page) |p| munmapPtr(p, uapi.reg_map_bytes);
+        if (q.rx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        if (q.tx_ring) |p| munmapPtr(@ptrCast(p), uapi.ring_bytes);
+        q.reg_page = null;
+        q.rx_ring = null;
+        q.tx_ring = null;
+    }
+
+    fn reclaimTx(q: *Queue) void {
+        const tx = q.tx_ring.?;
+        while (q.tx_cons != q.tx_prod) {
+            const c0 = q.tx_cons & uapi.ring_mask;
+            const cnt: u32 = q.tx_desc_cnt[c0];
+            const last = (q.tx_cons +% cnt -% 1) & uapi.ring_mask;
+            if ((@atomicLoad(u32, &tx[last].d3, .acquire) & uapi.desc_own) != 0) break;
+            q.tx_cons +%= cnt;
+        }
+    }
+
+    fn ringTx(q: *Queue) void {
+        const tail = q.tx_prod & uapi.ring_mask;
+        mmioWrite32(q.ch_reg, uapi.ch_tdtlp, @truncate(q.tx_ring_iova +% @as(u64, tail) * 16));
+    }
+
+    fn ringRx(q: *Queue) void {
+        const tail = q.rx_prod & uapi.ring_mask;
+        mmioWrite32(q.ch_reg, uapi.ch_rdtlp, @truncate(q.rx_ring_iova +% @as(u64, tail) * 16));
+    }
+
+    fn sendCtrlHdr(q: *Queue, local_mac: [6]u8, peer_mac: [6]u8, in: WireHdr) void {
+        while ((q.tx_prod -% q.tx_cons) >= (uapi.ring_desc_cnt - 8)) q.reclaimTx();
+        const idx = q.tx_prod & uapi.ring_mask;
+        const h: *WireHdr = @ptrCast(@alignCast(q.tx_hdr_va + @as(usize, idx) * hdr_bytes));
+        h.* = in;
+        h.dst_mac = peer_mac;
+        h.src_mac = local_mac;
+        h.ethertype_be = std.mem.nativeToBig(u16, uapi.ethtype_ctrl);
+        h.payload_len = 0;
+        h.magic = wire_magic;
+        cacheCleanRange(@ptrCast(h), hdr_bytes);
+
+        const hiova = q.tx_hdr_iova + @as(u64, idx) * hdr_bytes;
+        const tx = q.tx_ring.?;
+        q.tx_desc_cnt[idx] = 1;
+        tx[idx].d0 = @truncate(hiova);
+        tx[idx].d1 = @truncate(hiova >> 32);
+        tx[idx].d2 = hdr_bytes;
+        dsbSy();
+        @atomicStore(u32, &tx[idx].d3, uapi.desc_own | uapi.desc_fd | uapi.desc_ld | hdr_bytes, .release);
+        q.tx_prod +%= 1;
+        q.ringTx();
+    }
+
+    fn sendGather(q: *Queue, ethertype: u16, local_mac: [6]u8, peer_mac: [6]u8, in: WireHdr, pay_iova: u64, plen: u32, ring_db: bool) void {
+        if (plen == 0) {
+            q.sendCtrlHdr(local_mac, peer_mac, in);
+            return;
+        }
+        while ((q.tx_prod -% q.tx_cons) >= (uapi.ring_desc_cnt - 8)) q.reclaimTx();
+        const d0 = q.tx_prod & uapi.ring_mask;
+        const d1 = (q.tx_prod +% 1) & uapi.ring_mask;
+        const h: *WireHdr = @ptrCast(@alignCast(q.tx_hdr_va + @as(usize, d0) * hdr_bytes));
+        h.* = in;
+        h.dst_mac = peer_mac;
+        h.src_mac = local_mac;
+        h.ethertype_be = std.mem.nativeToBig(u16, ethertype);
+        h.payload_len = plen;
+        h.magic = wire_magic;
+        cacheCleanRange(@ptrCast(h), hdr_bytes);
+
+        const tx = q.tx_ring.?;
+        q.tx_desc_cnt[d0] = 2;
+        tx[d1].d0 = @truncate(pay_iova);
+        tx[d1].d1 = @truncate(pay_iova >> 32);
+        tx[d1].d2 = plen & uapi.tdes2_b1l_mask;
+        tx[d1].d3 = uapi.desc_own | uapi.desc_ld;
+        dmbOshst();
+
+        const hiova = q.tx_hdr_iova + @as(u64, d0) * hdr_bytes;
+        tx[d0].d0 = @truncate(hiova);
+        tx[d0].d1 = @truncate(hiova >> 32);
+        tx[d0].d2 = hdr_bytes;
+        dsbSy();
+        const fl: u32 = (@as(u32, hdr_bytes) + plen) & uapi.tdes3_fl_mask;
+        @atomicStore(u32, &tx[d0].d3, uapi.desc_own | uapi.desc_fd | fl, .release);
+        q.tx_prod +%= 2;
+        if (ring_db) q.ringTx();
+    }
+
+    const CtrlRx = struct { hdr: WireHdr, payload: []const u8, valid: bool };
+
+    fn peekCtrl(q: *Queue) ?CtrlRx {
+        const rx = q.rx_ring.?;
+        const idx = q.rx_cons & uapi.ring_mask;
+        const d3 = @atomicLoad(u32, &rx[idx].d3, .acquire);
+        if ((d3 & uapi.desc_own) != 0) return null;
+
+        const slot_va = q.rx_buf_va + @as(usize, idx) * q.rx_stride;
+        const wlen: usize = d3 & uapi.rdes3_pl_mask;
+        const inv_len = @min(q.rx_stride, @max(hdr_bytes, wlen));
+        cacheInvalRange(slot_va, inv_len);
+        const h: *const WireHdr = @ptrCast(@alignCast(slot_va));
+        const ok = (d3 & uapi.rdes3_es_mgbe) == 0 and (d3 & uapi.desc_ctxt) == 0 and
+            wlen >= hdr_bytes and h.magic == wire_magic and wlen >= hdr_bytes + h.payload_len;
+        const plen: usize = if (ok) h.payload_len else 0;
+        return .{ .hdr = if (ok) h.* else .{}, .payload = (slot_va + hdr_bytes)[0..plen], .valid = ok };
+    }
+
+    fn consumeCtrl(q: *Queue) void {
+        const rx = q.rx_ring.?;
+        const idx = q.rx_cons & uapi.ring_mask;
+        rx[idx].d3 = 0;
+
+        const refill = q.rx_prod & uapi.ring_mask;
+        cacheInvalRange(q.rx_buf_va + @as(usize, refill) * q.rx_stride, hdr_bytes);
+        const b = q.rx_buf_iova + @as(u64, refill) * q.rx_stride;
+        rx[refill].d0 = @truncate(b);
+        rx[refill].d1 = @truncate(b >> 32);
+        rx[refill].d2 = 0;
+        dsbSy();
+        @atomicStore(u32, &rx[refill].d3, uapi.desc_own, .release);
+
+        q.rx_cons +%= 1;
+        q.rx_prod +%= 1;
+        q.ringRx();
+    }
+
+    fn postDdpRx(q: *Queue, dst_iova: u64, npkts: u32) void {
+        const rx = q.rx_ring.?;
+        for (0..npkts) |k| {
+            const idx = q.rx_prod & uapi.ring_mask;
+            cacheInvalRange(q.rx_buf_va + @as(usize, idx) * q.rx_stride, hdr_bytes + 64);
+            const hiova = q.rx_buf_iova + @as(u64, idx) * q.rx_stride;
+            const piova = dst_iova + @as(u64, k) * max_payload;
+            rx[idx].d0 = @truncate(hiova);
+            rx[idx].d1 = @truncate(hiova >> 32);
+            rx[idx].d2 = @truncate(piova);
+            dmbOshst();
+            @atomicStore(u32, &rx[idx].d3, (@as(u32, @truncate(piova >> 32)) & 0xFFFF) | uapi.desc_own, .release);
+            q.rx_prod +%= 1;
+        }
+        const tail = q.rx_prod & uapi.ring_mask;
+        rx[tail].d3 = 0;
+        q.ringRx();
+    }
+
+    fn postDdpDrain(q: *Queue, scratch_iova: u64, npkts: u32) void {
+        const rx = q.rx_ring.?;
+        for (0..npkts) |_| {
+            const idx = q.rx_prod & uapi.ring_mask;
+            cacheInvalRange(q.rx_buf_va + @as(usize, idx) * q.rx_stride, hdr_bytes + 64);
+            const hiova = q.rx_buf_iova + @as(u64, idx) * q.rx_stride;
+            rx[idx].d0 = @truncate(hiova);
+            rx[idx].d1 = @truncate(hiova >> 32);
+            rx[idx].d2 = @truncate(scratch_iova);
+            dmbOshst();
+            @atomicStore(u32, &rx[idx].d3, (@as(u32, @truncate(scratch_iova >> 32)) & 0xFFFF) | uapi.desc_own, .release);
+            q.rx_prod +%= 1;
+        }
+        const tail = q.rx_prod & uapi.ring_mask;
+        rx[tail].d3 = 0;
+        q.ringRx();
+    }
+
+    const DataComp = struct { hdr: WireHdr, plen: u32, err: bool };
+
+    fn dumpState(q: *const Queue, tag: []const u8) void {
+        const cur_rx = mmioRead32(q.ch_reg, 0x4C);
+        const rdtlp = mmioRead32(q.ch_reg, uapi.ch_rdtlp);
+        const cur_tx = mmioRead32(q.ch_reg, 0x44);
+        const tdtlp = mmioRead32(q.ch_reg, uapi.ch_tdtlp);
+        const status = mmioRead32(q.ch_reg, 0x60);
+        const rx_base_lo: u32 = @truncate(q.rx_ring_iova);
+        const tx_base_lo: u32 = @truncate(q.tx_ring_iova);
+        const hw_rx_idx = (cur_rx -% rx_base_lo) / 16;
+        const hw_rx_tail = (rdtlp -% rx_base_lo) / 16;
+        const hw_tx_idx = (cur_tx -% tx_base_lo) / 16;
+        const hw_tx_tail = (tdtlp -% tx_base_lo) / 16;
+        const rx = q.rx_ring.?;
+        const c = q.rx_cons & uapi.ring_mask;
+        const p = q.rx_prod & uapi.ring_mask;
+        var own0: u32 = 0;
+        var first_own0: i32 = -1;
+        var last_own0: i32 = -1;
+        for (0..uapi.ring_desc_cnt) |i| {
+            if ((@atomicLoad(u32, &rx[i].d3, .acquire) & uapi.desc_own) == 0) {
+                own0 += 1;
+                if (first_own0 < 0) first_own0 = @intCast(i);
+                last_own0 = @intCast(i);
+            }
+        }
+        std.log.err(
+            "mgbe_zc dump [{s} port={d} q={d} ch={d}] status=0x{x} RX(cons={d}({d}) prod={d}({d}) hw_cur={d} hw_tail={d} own0={d} [{d}..{d}]) TX(cons={d} prod={d} hw_cur={d} hw_tail={d}) d3[c-1..c+2]=[0x{x},0x{x},0x{x},0x{x}]",
+            .{
+                tag,      q.port,    q.qidx,    q.hw_chan,   status,
+                q.rx_cons, c,        q.rx_prod, p,           hw_rx_idx,
+                hw_rx_tail, own0,    first_own0, last_own0,  q.tx_cons,
+                q.tx_prod, hw_tx_idx, hw_tx_tail,
+                rx[(c -% 1) & uapi.ring_mask].d3,
+                rx[c].d3,
+                rx[(c +% 1) & uapi.ring_mask].d3,
+                rx[(c +% 2) & uapi.ring_mask].d3,
+            },
+        );
+    }
+
+    fn pollDataRx(q: *Queue) ?DataComp {
+        const rx = q.rx_ring.?;
+        while (q.rx_cons != q.rx_prod) {
+            const idx = q.rx_cons & uapi.ring_mask;
+            const d3 = @atomicLoad(u32, &rx[idx].d3, .acquire);
+            if ((d3 & uapi.desc_own) != 0) return null;
+            q.rx_cons +%= 1;
+            if ((d3 & uapi.desc_ctxt) != 0) continue;
+            const hva = q.rx_buf_va + @as(usize, idx) * q.rx_stride;
+            cacheInvalRange(hva, hdr_bytes);
+            const h: *const WireHdr = @ptrCast(@alignCast(hva));
+            const wpl: u32 = d3 & uapi.rdes3_pl_mask;
+            const plen: u32 = if (wpl >= @as(u32, hdr_bytes)) wpl - @as(u32, hdr_bytes) else 0;
+            const bad = (d3 & uapi.rdes3_es_mgbe) != 0 or h.magic != wire_magic;
+            return .{ .hdr = h.*, .plen = plen, .err = bad };
+        }
+        return null;
+    }
+};
+
+const EagerSlot = struct {
+    seq: u32 = 0,
+    mask: u32 = 0,
+    total_pkts: u16 = 0,
+    nbytes: u32 = 0,
+
+    fn done(e: EagerSlot) bool {
+        if (e.total_pkts == 0) return e.mask == 1;
+        if (e.total_pkts > 31) return false;
+        const want = (@as(u32, 1) << @intCast(e.total_pkts)) - 1;
+        return e.mask == want;
+    }
+};
+
+const EagerTxHist = struct {
+    seq: u32 = 0,
+    nbytes: u32 = 0,
+    off: usize = 0,
+    len: usize = 0,
+};
+
+const StashedRts = struct {
+    valid: bool = false,
+    seq: u32 = 0,
+    nbytes: u32 = 0,
+};
+
+const StashedCts = struct {
+    valid: bool = false,
+    seq: u32 = 0,
+    win_start: u32 = 0,
+    win_pkts: u16 = 0,
+    cts_gen: u32 = 0,
+};
+
+const Rail = struct {
+    rail_idx: usize = 0,
+    port: u32 = 0,
+    local_mac: [6]u8 = @splat(0),
+    peer_mac: [6]u8 = @splat(0),
+    ifname: [16]u8 = @splat(0),
+    pool_va: ?[*]align(4096) u8 = null,
+    pool_mr_id: u32 = 0,
+    pool_iova: u64 = 0,
+    region_iova: u64 = 0,
+    ctrl_q: Queue = .{},
+    data_q: Queue = .{},
+    last_seq: u64 = 0,
+    last_seq32: u32 = 0,
+    pin_cpu: i32 = -1,
+    eager_rx: [max_slots]EagerSlot = @splat(.{}),
+    eager_tx_hist: [max_slots]EagerTxHist = @splat(.{}),
+    stashed_rts: StashedRts = .{},
+    stashed_cts: StashedCts = .{},
+    stashed_ack_seq: u32 = 0,
+    stashed_ack_win: u32 = 0,
+    has_stashed_ack: bool = false,
+    stashed_nack_seq: u32 = 0,
+    stashed_nack_win: u32 = 0,
+    stashed_nack_flush: u16 = 0,
+    stashed_nack_gen: u32 = 0,
+    has_stashed_nack: bool = false,
+    peer_max_seq: u32 = 0,
+    in_ddp_rx: bool = false,
+    ddp_seq: u32 = 0,
+    ddp_rx_win_start: u32 = 0,
+    ddp_rx_acked: bool = false,
+    thread: ?std.Thread = null,
+    eager_cnt: u64 = 0,
+    ddp_cnt: u64 = 0,
+    retrans_cnt: u64 = 0,
+};
+
+pub fn stripeFor(nbytes: usize, rail: usize, n_ports: usize) struct { off: usize, len: usize } {
+    const packs = nbytes / 16;
+    const base = packs / n_ports;
+    const rem = packs % n_ports;
+    const before = rail * base + @min(rail, rem);
+    const mine = base + @as(usize, if (rail < rem) 1 else 0);
+    return .{ .off = before * 16, .len = mine * 16 };
+}
+
+fn parseCsvU32(text: []const u8, out: []u32) usize {
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, text, ',');
+    while (it.next()) |tok| {
+        if (n >= out.len) break;
+        const trimmed = std.mem.trim(u8, tok, " \t\r\n");
+        if (trimmed.len == 0) continue;
+        out[n] = std.fmt.parseInt(u32, trimmed, 10) catch continue;
+        n += 1;
+    }
+    return n;
+}
+
+fn parseCsvI32(text: []const u8, out: []i32) usize {
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, text, ',');
+    while (it.next()) |tok| {
+        if (n >= out.len) break;
+        const trimmed = std.mem.trim(u8, tok, " \t\r\n");
+        if (trimmed.len == 0) continue;
+        out[n] = std.fmt.parseInt(i32, trimmed, 10) catch continue;
+        n += 1;
+    }
+    return n;
+}
+
+pub const FailCallback = struct {
+    ctx: *anyopaque,
+    fail: *const fn (ctx: *anyopaque, why: []const u8) void,
+};
+
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    d: *const Driver,
+    rank: u32,
+    slots: u32,
+    slot_mask: u32,
+    fd: i32 = -1,
+    n_ports: u32 = 0,
+    rails: [max_ports]Rail = @splat(.{}),
+    layout: Layout,
+    region: HostNumaRegion,
+    region_mr_id: u32 = 0,
+    max_bytes: usize,
+    eager_max: usize,
+    timeout_ns: u64,
+    arrival_timeout_ns: u64,
+    idle_ns: u64,
+    nap_ns: u64,
+    debug: bool,
+    running: std.atomic.Value(bool) = .init(false),
+    arrived: [max_slots]std.atomic.Value(u32) = @splat(.init(0)),
+    fail_cb: ?FailCallback = null,
+    err: [256]u8 = @splat(0),
+
+    pub fn create(gpa: std.mem.Allocator, d: *const Driver, rank: u32, slots: u32, max_bytes: usize, idle_ns: u64, nap_ns: u64) !*State {
+        if (comptime builtin.os.tag != .linux) return error.UnsupportedPlatform;
+        if (rank >= 2) return error.BadLayout;
+        const layout = try Layout.of(slots, max_bytes);
+        const s = try gpa.create(State);
+        errdefer gpa.destroy(s);
+        const xfer_ns = timeoutNsFromEnv();
+        s.* = .{
+            .gpa = gpa,
+            .d = d,
+            .rank = rank,
+            .slots = slots,
+            .slot_mask = slots - 1,
+            .layout = layout,
+            .region = undefined,
+            .max_bytes = layout.slot_bytes,
+            .eager_max = eagerMaxBytesFromEnv(),
+            .timeout_ns = xfer_ns,
+            .arrival_timeout_ns = arrivalTimeoutNsFromEnv(xfer_ns),
+            .idle_ns = idle_ns,
+            .nap_ns = nap_ns,
+            .debug = debugOn(),
+        };
+        const fd_rc = std.os.linux.open(uapi.dev_path.ptr, .{ .ACCMODE = .RDWR, .CLOEXEC = true }, 0);
+        const fd_signed: isize = @bitCast(fd_rc);
+        if (fd_signed < 0) {
+            s.noteErr("open {s} failed (errno {d})", .{ uapi.dev_path, -fd_signed });
+            return error.DeviceUnavailable;
+        }
+        s.fd = @intCast(fd_signed);
+        errdefer {
+            closeFd(s.fd);
+            s.fd = -1;
+        }
+
+        // Discover requested or all present+up+MTU>=8256+SPH ports.
+        var want_ports: [max_ports]u32 = .{ 0, 1, 2, 3 };
+        var n_want: usize = max_ports;
+        if (std.c.getenv("TF_MGBE_ZC_PORTS")) |v| {
+            const parsed = parseCsvU32(std.mem.span(v), &want_ports);
+            if (parsed > 0) n_want = parsed;
+        }
+        var cpus: [max_ports]i32 = @splat(-1);
+        if (std.c.getenv("TF_MGBE_ZC_CPUS")) |v| {
+            _ = parseCsvI32(std.mem.span(v), &cpus);
+        }
+
+        var count: u32 = 0;
+        for (want_ports[0..n_want]) |p| {
+            if (p >= max_ports) continue;
+            var pi: uapi.PortInfo = .{ .port = p };
+            ioctlCall(s.fd, uapi.ioc_port_info, @intFromPtr(&pi)) catch continue;
+            if (pi.present == 0 or pi.link_up == 0 or pi.sph_supported == 0 or pi.mtu < 8256) continue;
+            s.rails[count] = .{
+                .rail_idx = count,
+                .port = p,
+                .local_mac = pi.mac,
+                .ifname = pi.ifname,
+                .pin_cpu = cpus[count],
+            };
+            count += 1;
+        }
+        if (count == 0) {
+            s.noteErr("no up MGBE port with MTU>=8256 and SPH=1", .{});
+            return error.NoPorts;
+        }
+        s.n_ports = count;
+
+        // Allocate single GPU+NIC shared HOST_NUMA region (send + recv + meta) and register MR across all ports.
+        s.region = HostNumaRegion.alloc(d, s.layout.total) catch |e| {
+            s.noteErr("CUDA HOST_NUMA alloc ({d} B) failed: {s}", .{ s.layout.total, @errorName(e) });
+            return e;
+        };
+        errdefer s.region.free();
+
+        var rmr: uapi.MrReq = .{ .va = s.region.va, .len = s.region.size, .dmabuf_fd = -1 };
+        ioctlCall(s.fd, uapi.ioc_reg_mr, @intFromPtr(&rmr)) catch {
+            s.noteErr("REG_MR region ({d} B) failed", .{s.region.size});
+            return error.MrFailed;
+        };
+        s.region_mr_id = rmr.mr_id;
+        errdefer ioctlIgnore(s.fd, uapi.ioc_dereg_mr, @intFromPtr(&s.region_mr_id));
+
+        errdefer s.teardownRails();
+        for (0..s.n_ports) |r| {
+            const rl = &s.rails[r];
+            rl.region_iova = rmr.iova[rl.port];
+            rl.pool_va = try mmapAnon(port_pool_bytes);
+            @memset(rl.pool_va.?[0..port_pool_bytes], 0);
+            cacheInvalRange(rl.pool_va.?, port_pool_bytes);
+            var pmr: uapi.MrReq = .{ .va = @intFromPtr(rl.pool_va.?), .len = port_pool_bytes, .dmabuf_fd = -1 };
+            ioctlCall(s.fd, uapi.ioc_reg_mr, @intFromPtr(&pmr)) catch {
+                s.noteErr("REG_MR port {d} header pool failed", .{rl.port});
+                return error.MrFailed;
+            };
+            rl.pool_mr_id = pmr.mr_id;
+            rl.pool_iova = pmr.iova[rl.port];
+            try rl.ctrl_q.setup(
+                s.fd,
+                rl.port,
+                0,
+                false,
+                rl.pool_va.? + ctrl_tx_off,
+                rl.pool_iova + ctrl_tx_off,
+                rl.pool_va.? + ctrl_rx_off,
+                rl.pool_iova + ctrl_rx_off,
+                ctrl_rx_stride,
+            );
+            try rl.data_q.setup(
+                s.fd,
+                rl.port,
+                1,
+                true,
+                rl.pool_va.? + data_tx_off,
+                rl.pool_iova + data_tx_off,
+                rl.pool_va.? + data_rx_off,
+                rl.pool_iova + data_rx_off,
+                data_rx_stride,
+            );
+        }
+        return s;
+    }
+
+    pub fn info(s: *const State) Info {
+        var b: Info = .{};
+        b.ok = 1;
+        b.n_ports = s.n_ports;
+        b.slot_bytes = s.layout.slot_bytes;
+        b.max_bytes = s.max_bytes;
+        for (0..s.n_ports) |r| {
+            b.port_ids[r] = s.rails[r].port;
+            b.macs[r] = s.rails[r].local_mac;
+        }
+        return b;
+    }
+
+    pub fn connect(s: *State, peer: Info) Error!void {
+        if (peer.ok == 0 or peer.n_ports != s.n_ports or peer.slot_bytes != s.layout.slot_bytes) {
+            s.noteErr("peer mismatch (ok={d} ports={d}/{d} slot={d}/{d})", .{ peer.ok, peer.n_ports, s.n_ports, peer.slot_bytes, s.layout.slot_bytes });
+            return error.PeerRefused;
+        }
+        s.max_bytes = @intCast(@min(s.max_bytes, peer.max_bytes));
+        for (0..s.n_ports) |r| s.rails[r].peer_mac = peer.macs[r];
+    }
+
+    pub fn sendSlice(s: *const State) []align(Layout.section_align) u8 {
+        return @alignCast(s.region.ptr()[s.layout.send_off..][0..s.layout.send_len]);
+    }
+    pub fn sendDev(s: *const State) abi.DevicePtr {
+        return s.region.va + s.layout.send_off;
+    }
+    pub fn recvSlice(s: *const State) []align(Layout.section_align) u8 {
+        return @alignCast(s.region.ptr()[s.layout.recv_off..][0..s.layout.recv_len]);
+    }
+    pub fn recvDev(s: *const State) abi.DevicePtr {
+        return s.region.va + s.layout.recv_off;
+    }
+    pub fn metaSlice(s: *const State) []align(Layout.section_align) u8 {
+        return @alignCast(s.region.ptr()[s.layout.meta_off..][0..s.layout.meta_len]);
+    }
+    pub fn metaDev(s: *const State) abi.DevicePtr {
+        return s.region.va + s.layout.meta_off;
+    }
+
+    // Ring metadata views inside the HOST_NUMA region (exact same layout as dsv41/rdma.zig).
+    fn flags(s: *const State) [*]u64 {
+        return @ptrCast(@alignCast(s.region.ptr() + s.layout.meta_off));
+    }
+    fn doorbell(s: *const State) *u64 {
+        return &s.flags()[@as(usize, s.slots) * 2];
+    }
+    fn sizes(s: *const State) [*]u64 {
+        return s.flags() + @as(usize, s.slots) * 2 + 1;
+    }
+    fn sent(s: *const State) [*]u64 {
+        return s.sizes() + s.slots;
+    }
+    fn abortWord(s: *const State) *u64 {
+        return &s.sent()[s.slots];
+    }
+    fn flagAt(s: *const State, q: u64, peer: usize) *u64 {
+        const slot: usize = @intCast(q & s.slot_mask);
+        return &s.flags()[slot * 2 + peer];
+    }
+    fn aborted(s: *const State) bool {
+        return @atomicLoad(u64, s.abortWord(), .acquire) != 0;
+    }
+
+    fn sendSlotPtr(s: *const State, slot: usize) [*]u8 {
+        return s.region.ptr() + s.layout.sendAt(slot);
+    }
+    fn recvSlotPtr(s: *const State, slot: usize, from_rank: usize) [*]u8 {
+        return s.region.ptr() + s.layout.recvAt(slot, from_rank);
+    }
+
+    fn noteErr(s: *State, comptime fmt: []const u8, args: anytype) void {
+        _ = std.fmt.bufPrint(s.err[0 .. s.err.len - 1], fmt, args) catch {};
+    }
+
+    pub fn lastErr(s: *const State) []const u8 {
+        return std.mem.sliceTo(&s.err, 0);
+    }
+
+    fn reportFailure(s: *State) void {
+        const msg = s.lastErr();
+        if (s.fail_cb) |cb| cb.fail(cb.ctx, if (msg.len > 0) msg else "mgbe_zc proxy failed");
+        @atomicStore(u64, s.abortWord(), 1, .release);
+    }
+
+    /// Bidirectional L2 ctrl + 64 KiB SPH=1 DDP probe on every rail before arming workers.
+    pub fn probeAll(s: *State) Error!void {
+        for (0..s.n_ports) |r| try s.probeRail(&s.rails[r]);
+        @memset(s.region.ptr()[0..s.layout.total], 0);
+        cacheCleanRange(s.region.ptr(), s.layout.total);
+    }
+
+    fn probeRail(s: *State, rl: *Rail) Error!void {
+        const deadline = nowNs() + 5_000_000_000;
+        // 1. Ctrl L2 ping-pong verifying peer MAC pairing.
+        var got_peer_probe = false;
+        var got_ack = false;
+        var last_tx: u64 = 0;
+        while (!(got_peer_probe and got_ack)) {
+            const t = nowNs();
+            if (t >= deadline) {
+                s.noteErr("port {d} ({s}) ctrl probe timed out", .{ rl.port, std.mem.sliceTo(&rl.ifname, 0) });
+                return error.ProbeFailed;
+            }
+            if (!got_ack and (t - last_tx) >= 2_000_000) {
+                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe), .seq = 0x50520000 | rl.port });
+                last_tx = t;
+            }
+            if (rl.ctrl_q.peekCtrl()) |rx| {
+                const h = rx.hdr;
+                const ok = rx.valid;
+                rl.ctrl_q.consumeCtrl();
+                if (!ok) continue;
+                if (h.opcode == @intFromEnum(Op.probe)) {
+                    got_peer_probe = true;
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe_ack), .seq = h.seq });
+                } else if (h.opcode == @intFromEnum(Op.probe_ack)) {
+                    got_ack = true;
+                }
+            }
+        }
+        // 2. 64 KiB (8 packets) bidirectional SPH=1 DDP probe into HOST_NUMA recv[0][peer].
+        const peer: usize = 1 - s.rank;
+        const probe_pkts: u32 = 8;
+        const probe_bytes: usize = probe_pkts * max_payload;
+        const send_va = s.sendSlotPtr(0);
+        const recv_va = s.recvSlotPtr(0, peer);
+        const send_iova = rl.region_iova + s.layout.sendAt(0);
+        const recv_iova = rl.region_iova + s.layout.recvAt(0, peer);
+        const my_tag: u8 = if (s.rank == 0) 0xA5 else 0x5A;
+        const peer_tag: u8 = if (s.rank == 0) 0x5A else 0xA5;
+        for (0..probe_bytes) |i| send_va[i] = my_tag ^ @as(u8, @truncate((i *% 31) >> 3));
+        cacheCleanRange(send_va, probe_bytes);
+        @memset(recv_va[0..probe_bytes], 0xEE);
+        cacheInvalRange(recv_va, probe_bytes);
+
+        rl.data_q.postDdpRx(recv_iova, probe_pkts);
+        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.cts), .seq = 0, .win_start = 0, .win_pkts = probe_pkts, .cts_gen = 1 });
+
+        var peer_cts = false;
+        var tx_sent = false;
+        var peer_ack = false;
+        var rx_got: u32 = 0;
+        var last_cts_tx = nowNs();
+        while (!(rx_got == probe_pkts and peer_ack)) {
+            const t = nowNs();
+            if (t >= deadline) {
+                s.noteErr("port {d} DDP probe timed out (rx={d}/{d}, cts={}, ack={})", .{ rl.port, rx_got, probe_pkts, peer_cts, peer_ack });
+                return error.ProbeFailed;
+            }
+            if (!tx_sent and !peer_cts and (t - last_cts_tx) >= 2_000_000) {
+                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.cts), .seq = 0, .win_start = 0, .win_pkts = probe_pkts, .cts_gen = 1 });
+                last_cts_tx = t;
+            }
+            while (rl.ctrl_q.peekCtrl()) |rx| {
+                const h = rx.hdr;
+                const ok = rx.valid;
+                rl.ctrl_q.consumeCtrl();
+                if (!ok) continue;
+                if (h.opcode == @intFromEnum(Op.probe)) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.probe_ack), .seq = h.seq });
+                } else if (h.opcode == @intFromEnum(Op.cts) and h.seq == 0) {
+                    peer_cts = true;
+                } else if (h.opcode == @intFromEnum(Op.ack) and h.seq == 0) {
+                    peer_ack = true;
+                }
+            }
+            if (peer_cts and !tx_sent) {
+                for (0..probe_pkts) |k| {
+                    rl.data_q.sendGather(
+                        uapi.ethtype_data,
+                        rl.local_mac,
+                        rl.peer_mac,
+                        .{ .opcode = @intFromEnum(Op.bulk_data), .seq = 0, .psn = @intCast(k), .win_pkts = probe_pkts, .cts_gen = 1 },
+                        send_iova + @as(u64, k) * max_payload,
+                        max_payload,
+                        k + 1 == probe_pkts,
+                    );
+                }
+                tx_sent = true;
+            }
+            while (rl.data_q.pollDataRx()) |comp| {
+                if (comp.err or comp.hdr.opcode != @intFromEnum(Op.bulk_data) or comp.hdr.psn != rx_got or comp.plen != max_payload) {
+                    s.noteErr("port {d} DDP probe bad pkt (err={} psn={d} want={d} plen={d})", .{ rl.port, comp.err, comp.hdr.psn, rx_got, comp.plen });
+                    return error.ProbeFailed;
+                }
+                rx_got += 1;
+                if (rx_got == probe_pkts) {
+                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{ .opcode = @intFromEnum(Op.ack), .seq = 0, .win_start = 0, .win_pkts = probe_pkts });
+                }
+            }
+        }
+        cacheInvalRange(recv_va, probe_bytes);
+        for (0..probe_bytes) |i| {
+            const want = peer_tag ^ @as(u8, @truncate((i *% 31) >> 3));
+            if (recv_va[i] != want) {
+                s.noteErr("port {d} DDP probe payload mismatch at byte {d} (got 0x{x} want 0x{x})", .{ rl.port, i, recv_va[i], want });
+                return error.ProbeFailed;
+            }
+        }
+        if (s.debug) std.log.info("mgbe_zc rank {d} port {d} ({s}): ctrl+DDP probe OK", .{ s.rank, rl.port, std.mem.sliceTo(&rl.ifname, 0) });
+    }
+
+    pub fn start(s: *State, cb: FailCallback) std.Thread.SpawnError!void {
+        if (s.running.swap(true, .acq_rel)) return;
+        s.fail_cb = cb;
+        errdefer s.stop();
+        for (0..s.n_ports) |r| {
+            s.rails[r].thread = try std.Thread.spawn(.{}, railWorker, .{ s, r });
+        }
+    }
+
+    pub fn stop(s: *State) void {
+        if (s.running.swap(false, .acq_rel)) {
+            for (0..s.n_ports) |r| {
+                if (s.rails[r].thread) |t| t.join();
+                s.rails[r].thread = null;
+            }
+        }
+    }
+
+    fn teardownRails(s: *State) void {
+        for (0..s.n_ports) |r| {
+            const rl = &s.rails[r];
+            rl.data_q.teardown(s.fd);
+            rl.ctrl_q.teardown(s.fd);
+            if (rl.pool_mr_id != 0 and s.fd >= 0) {
+                ioctlIgnore(s.fd, uapi.ioc_dereg_mr, @intFromPtr(&rl.pool_mr_id));
+                rl.pool_mr_id = 0;
+            }
+            if (rl.pool_va) |p| {
+                munmapPtr(p, port_pool_bytes);
+                rl.pool_va = null;
+            }
+        }
+    }
+
+    pub fn destroy(s: *State) void {
+        s.stop();
+        if (s.debug and s.n_ports > 0 and (s.rails[0].eager_cnt > 0 or s.rails[0].ddp_cnt > 0)) {
+            std.log.info("mgbe_zc rank {d}: rail0 eager={d} ddp={d} retrans={d}", .{
+                s.rank, s.rails[0].eager_cnt, s.rails[0].ddp_cnt, s.rails[0].retrans_cnt,
+            });
+        }
+        s.teardownRails();
+        if (s.region_mr_id != 0 and s.fd >= 0) {
+            ioctlIgnore(s.fd, uapi.ioc_dereg_mr, @intFromPtr(&s.region_mr_id));
+            s.region_mr_id = 0;
+        }
+        s.region.free();
+        if (s.fd >= 0) {
+            closeFd(s.fd);
+            s.fd = -1;
+        }
+        s.gpa.destroy(s);
+    }
+
+    /// Poll ctrl_q for incoming control/eager packets, handling both current and lookahead frames.
+    /// Returns true if at least one frame was processed.
+    fn drainCtrlRx(s: *State, rl: *Rail) bool {
+        var any = false;
+        const peer: usize = 1 - s.rank;
+        while (rl.ctrl_q.peekCtrl()) |rx| {
+            any = true;
+            const h = rx.hdr;
+            const ok = rx.valid;
+            if (ok) {
+                const is_data_op = h.opcode == @intFromEnum(Op.eager) or
+                    h.opcode == @intFromEnum(Op.rts) or
+                    h.opcode == @intFromEnum(Op.cts) or
+                    h.opcode == @intFromEnum(Op.ack) or
+                    h.opcode == @intFromEnum(Op.nack) or
+                    h.opcode == @intFromEnum(Op.ack_req) or
+                    h.opcode == @intFromEnum(Op.eager_req);
+                const seq_ahead: i32 = @bitCast(h.seq -% rl.last_seq32);
+                if (is_data_op and h.seq != 0 and seq_ahead > 0 and seq_ahead <= @as(i32, @intCast(s.slots)) and
+                    @as(i32, @bitCast(h.seq -% rl.peer_max_seq)) > 0)
+                {
+                    rl.peer_max_seq = h.seq;
+                }
+                switch (h.opcode) {
+                    @intFromEnum(Op.eager) => {
+                        const slot: usize = @intCast(h.seq & s.slot_mask);
+                        if ((h.flags & flag_retrans) != 0 and h.seq != 0 and h.seq == rl.eager_tx_hist[slot].seq and
+                            @as(i32, @bitCast(h.seq -% rl.last_seq32)) <= 0)
+                        {
+                            // Peer missed our eager frame after we exited runExchange(h.seq); send[slot] is still
+                            // intact because the ping-pong slots cannot wrap until peer completes h.seq.
+                            const th = rl.eager_tx_hist[slot];
+                            s.sendEagerBurst(rl, th.seq, th.nbytes, th.off, th.len, false);
+                            rl.retrans_cnt += 1;
+                        }
+                        const es = &rl.eager_rx[slot];
+                        if (h.seq != es.seq) {
+                            if (h.seq != 0 and @as(i32, @bitCast(h.seq -% rl.last_seq32)) > 0) {
+                                es.* = .{ .seq = h.seq, .mask = 0, .total_pkts = h.total_pkts, .nbytes = h.nbytes };
+                            } else {
+                                rl.ctrl_q.consumeCtrl();
+                                continue;
+                            }
+                        }
+                        if (h.total_pkts > 0 and h.total_pkts <= 31 and h.psn < h.total_pkts) {
+                            const bit = @as(u32, 1) << @intCast(h.psn);
+                            if ((es.mask & bit) == 0) {
+                                const st = stripeFor(h.nbytes, rl.rail_idx, s.n_ports);
+                                const rel_off = st.off + @as(usize, h.psn) * max_payload;
+                                if (rel_off + rx.payload.len <= s.layout.slot_bytes) {
+                                    @memcpy((s.recvSlotPtr(slot, peer) + rel_off)[0..rx.payload.len], rx.payload);
+                                }
+                                es.mask |= bit;
+                            }
+                        } else if (h.total_pkts == 0) {
+                            es.mask = 1;
+                        }
+                    },
+                    @intFromEnum(Op.eager_req) => {
+                        const slot: usize = @intCast(h.seq & s.slot_mask);
+                        if (h.seq != 0 and h.seq == rl.eager_tx_hist[slot].seq) {
+                            const th = rl.eager_tx_hist[slot];
+                            s.sendEagerBurst(rl, th.seq, th.nbytes, th.off, th.len, false);
+                            rl.retrans_cnt += 1;
+                        }
+                    },
+                    @intFromEnum(Op.rts) => {
+                        if (!rl.stashed_rts.valid or @as(i32, @bitCast(h.seq -% rl.stashed_rts.seq)) >= 0) {
+                            rl.stashed_rts = .{ .valid = true, .seq = h.seq, .nbytes = h.nbytes };
+                        }
+                    },
+                    @intFromEnum(Op.cts) => {
+                        if (!rl.stashed_cts.valid or
+                            @as(i32, @bitCast(h.seq -% rl.stashed_cts.seq)) > 0 or
+                            (h.seq == rl.stashed_cts.seq and (h.win_start > rl.stashed_cts.win_start or
+                                (h.win_start == rl.stashed_cts.win_start and @as(i32, @bitCast(h.cts_gen -% rl.stashed_cts.cts_gen)) >= 0))))
+                        {
+                            rl.stashed_cts = .{ .valid = true, .seq = h.seq, .win_start = h.win_start, .win_pkts = h.win_pkts, .cts_gen = h.cts_gen };
+                        }
+                    },
+                    @intFromEnum(Op.ack) => {
+                        if (!rl.has_stashed_ack or
+                            @as(i32, @bitCast(h.seq -% rl.stashed_ack_seq)) > 0 or
+                            (h.seq == rl.stashed_ack_seq and h.win_start >= rl.stashed_ack_win))
+                        {
+                            rl.stashed_ack_seq = h.seq;
+                            rl.stashed_ack_win = h.win_start;
+                            rl.has_stashed_ack = true;
+                        }
+                    },
+                    @intFromEnum(Op.ack_req) => {
+                        if (h.seq != 0) {
+                            const already_acked = (@as(i32, @bitCast(h.seq -% rl.last_seq32)) <= 0) or
+                                (rl.in_ddp_rx and h.seq == rl.ddp_seq and (h.win_start < rl.ddp_rx_win_start or
+                                    (h.win_start == rl.ddp_rx_win_start and rl.ddp_rx_acked)));
+                            if (already_acked) {
+                                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                    .opcode = @intFromEnum(Op.ack),
+                                    .seq = h.seq,
+                                    .win_start = h.win_start,
+                                    .win_pkts = h.win_pkts,
+                                });
+                                rl.retrans_cnt += 1;
+                            }
+                        }
+                    },
+                    @intFromEnum(Op.nack) => {
+                        if (@as(i32, @bitCast(h.seq -% rl.last_seq32)) > 0) {
+                            rl.stashed_nack_seq = h.seq;
+                            rl.stashed_nack_win = h.win_start;
+                            rl.stashed_nack_flush = h.win_pkts;
+                            rl.stashed_nack_gen = h.cts_gen;
+                            rl.has_stashed_nack = true;
+                        }
+                    },
+                    else => {},
+                }
+            }
+            rl.ctrl_q.consumeCtrl();
+        }
+        return any;
+    }
+
+    fn sendEagerBurst(s: *State, rl: *Rail, seq32: u32, nbytes: u32, off: usize, len: usize, is_retrans: bool) void {
+        const slot: usize = @intCast(seq32 & s.slot_mask);
+        const send_iova = rl.region_iova + s.layout.sendAt(slot) + off;
+        const npkts: u16 = if (len == 0) 0 else @intCast((len + max_payload - 1) / max_payload);
+        if (npkts == 0) {
+            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                .opcode = @intFromEnum(Op.eager),
+                .flags = if (is_retrans) flag_retrans else 0,
+                .seq = seq32,
+                .nbytes = nbytes,
+                .total_pkts = 0,
+            });
+            return;
+        }
+        for (0..npkts) |k| {
+            const po = k * max_payload;
+            const plen: u32 = @intCast(@min(max_payload, len - po));
+            rl.ctrl_q.sendGather(
+                uapi.ethtype_ctrl,
+                rl.local_mac,
+                rl.peer_mac,
+                .{
+                    .opcode = @intFromEnum(Op.eager),
+                    .flags = if (is_retrans and k == 0) flag_retrans else 0,
+                    .seq = seq32,
+                    .psn = @intCast(k),
+                    .total_pkts = npkts,
+                    .nbytes = nbytes,
+                },
+                send_iova + po,
+                plen,
+                k + 1 == npkts,
+            );
+        }
+    }
+
+    fn runExchange(s: *State, rl: *Rail, q: u64, tx_nbytes: u32) Error!void {
+        const seq32: u32 = @truncate(q);
+        const slot: usize = @intCast(q & s.slot_mask);
+        const peer: usize = 1 - s.rank;
+        const tx_st = stripeFor(tx_nbytes, rl.rail_idx, s.n_ports);
+        const tx_is_eager = tx_st.len <= s.eager_max;
+
+        if (tx_st.len > 0) cacheCleanRange(s.sendSlotPtr(slot) + tx_st.off, tx_st.len);
+
+        if (tx_is_eager) {
+            rl.eager_tx_hist[slot] = .{ .seq = seq32, .nbytes = tx_nbytes, .off = tx_st.off, .len = tx_st.len };
+            s.sendEagerBurst(rl, seq32, tx_nbytes, tx_st.off, tx_st.len, false);
+            const t0 = nowNs();
+            var peer_seen = @as(i32, @bitCast(rl.peer_max_seq -% seq32)) >= 0;
+            var t_xfer = t0;
+            var last_tx = t0;
+            while (s.running.load(.monotonic) and !s.aborted()) {
+                _ = s.drainCtrlRx(rl);
+                const es = &rl.eager_rx[slot];
+                if (es.seq == seq32 and es.done()) {
+                    const rx_st = stripeFor(es.nbytes, rl.rail_idx, s.n_ports);
+                    if (rx_st.len > 0) cacheCleanRange(s.recvSlotPtr(slot, peer) + rx_st.off, rx_st.len);
+                    rl.eager_cnt += 1;
+                    return;
+                }
+                if (rl.stashed_rts.valid and rl.stashed_rts.seq == seq32) {
+                    // Asymmetric exchange: our TX was eager, peer's TX is bulk DDP.
+                    const rx_nbytes = rl.stashed_rts.nbytes;
+                    rl.stashed_rts.valid = false;
+                    return s.runBulk(rl, seq32, slot, tx_nbytes, tx_st.off, tx_st.len, true, rx_nbytes);
+                }
+                const t = nowNs();
+                if (!peer_seen and @as(i32, @bitCast(rl.peer_max_seq -% seq32)) >= 0) {
+                    peer_seen = true;
+                    t_xfer = t;
+                }
+                if (t - last_tx >= 500_000) {
+                    s.sendEagerBurst(rl, seq32, tx_nbytes, tx_st.off, tx_st.len, true);
+                    rl.retrans_cnt += 1;
+                    last_tx = t;
+                }
+                const timed_out = if (peer_seen) (t - t_xfer >= s.timeout_ns) else (t - t0 >= s.arrival_timeout_ns);
+                if (timed_out) {
+                    rl.ctrl_q.dumpState("ctrl_q");
+                    s.noteErr("port {d} eager seq {d} ({d} B) timed out (got_seq={d} mask=0x{x} pkts={d} peer_max_seq={d} peer_seen={})", .{
+                        rl.port, seq32, tx_st.len, es.seq, es.mask, es.total_pkts, rl.peer_max_seq, peer_seen,
+                    });
+                    return error.ProxyFailed;
+                }
+            }
+            return error.ProxyFailed;
+        }
+
+        // Our TX is bulk DDP: announce tx_nbytes via RTS and drive independent TX & RX state machines.
+        return s.runBulk(rl, seq32, slot, tx_nbytes, tx_st.off, tx_st.len, false, null);
+    }
+
+    const RxMode = enum { unknown, eager, ddp };
+
+    fn runBulk(
+        s: *State,
+        rl: *Rail,
+        seq32: u32,
+        slot: usize,
+        tx_nbytes: u32,
+        tx_off: usize,
+        tx_len: usize,
+        tx_already_eager: bool,
+        known_rx_nbytes: ?u32,
+    ) Error!void {
+        const peer: usize = 1 - s.rank;
+        const send_iova = rl.region_iova + s.layout.sendAt(slot) + tx_off;
+        const recv_slot_va = s.recvSlotPtr(slot, peer);
+        const recv_slot_iova = rl.region_iova + s.layout.recvAt(slot, peer);
+
+        // TX DDP state
+        var tx_done = tx_already_eager;
+        const tx_total_pkts: u32 = if (tx_done) 0 else @intCast((tx_len + max_payload - 1) / max_payload);
+        var tx_win_start: u32 = 0;
+        var tx_win_pkts: u32 = if (tx_done) 0 else @min(bulk_win_max_pkts, tx_total_pkts);
+        var tx_allowed = false;
+        var tx_sent: u32 = 0;
+        var tx_flush: u32 = 0;
+        var tx_acked = false;
+        var peer_cts_gen: u32 = 0;
+
+        // RX state
+        var rx_mode: RxMode = .unknown;
+        var rx_done = false;
+        var rx_off: usize = 0;
+        var rx_len: usize = 0;
+        var rx_total_pkts: u32 = 0;
+        var rx_win_start: u32 = 0;
+        var rx_win_pkts: u32 = 0;
+        var rx_got: u32 = 0;
+        var rx_skip: u32 = 0;
+        var rx_gap = false;
+        var rx_draining = false;
+        var rx_drain_since: u64 = 0;
+        var rx_cts_gen: u32 = 1;
+
+        rl.in_ddp_rx = false;
+        rl.ddp_seq = seq32;
+        rl.ddp_rx_win_start = 0;
+        rl.ddp_rx_acked = false;
+        defer {
+            rl.in_ddp_rx = false;
+            rl.ddp_rx_acked = false;
+        }
+
+        const t_start = nowNs();
+        var peer_seen = (known_rx_nbytes != null) or (@as(i32, @bitCast(rl.peer_max_seq -% seq32)) >= 0);
+        var t_xfer = t_start;
+        var last_rts_tx = t_start;
+        var last_ack_req_tx = t_start;
+        var last_eager_req_tx = t_start;
+        var last_cts_tx = t_start;
+        var last_rx_activity = t_start;
+
+        if (!tx_done) {
+            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                .opcode = @intFromEnum(Op.rts),
+                .seq = seq32,
+                .nbytes = tx_nbytes,
+            });
+        }
+
+        if (known_rx_nbytes) |rnb| {
+            if (rnb > s.layout.slot_bytes) {
+                s.noteErr("port {d} seq {d}: peer rx_nbytes {d} > slot {d}", .{ rl.port, seq32, rnb, s.layout.slot_bytes });
+                return error.ProxyFailed;
+            }
+            const rst = stripeFor(rnb, rl.rail_idx, s.n_ports);
+            rx_off = rst.off;
+            rx_len = rst.len;
+            rx_total_pkts = if (rx_len == 0) 0 else @intCast((rx_len + max_payload - 1) / max_payload);
+            if (rx_total_pkts == 0) {
+                rx_done = true;
+            } else {
+                rx_mode = .ddp;
+                cacheInvalRange(recv_slot_va + rx_off, rx_len);
+                rx_win_start = 0;
+                rx_win_pkts = @min(bulk_win_max_pkts, rx_total_pkts);
+                rx_cts_gen = 1;
+                rl.in_ddp_rx = true;
+                rl.ddp_rx_win_start = 0;
+                rl.ddp_rx_acked = false;
+                rl.data_q.postDdpRx(recv_slot_iova + rx_off, rx_win_pkts);
+                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                    .opcode = @intFromEnum(Op.cts),
+                    .seq = seq32,
+                    .win_start = 0,
+                    .win_pkts = @intCast(rx_win_pkts),
+                    .nbytes = rnb,
+                    .cts_gen = rx_cts_gen,
+                });
+                last_cts_tx = nowNs();
+                last_rx_activity = last_cts_tx;
+            }
+        }
+
+        while (!(tx_done and rx_done)) {
+            if (!s.running.load(.monotonic) or s.aborted()) return error.ProxyFailed;
+            _ = s.drainCtrlRx(rl);
+            const t_now = nowNs();
+
+            // 1. Progress RX side.
+            var drained_any = false;
+            if (!rx_done) {
+                switch (rx_mode) {
+                    .unknown => {
+                        if (rl.stashed_rts.valid and rl.stashed_rts.seq == seq32) {
+                            const rnb = rl.stashed_rts.nbytes;
+                            rl.stashed_rts.valid = false;
+                            if (rnb > s.layout.slot_bytes) {
+                                s.noteErr("port {d} seq {d}: peer rx_nbytes {d} > slot {d}", .{ rl.port, seq32, rnb, s.layout.slot_bytes });
+                                return error.ProxyFailed;
+                            }
+                            const rst = stripeFor(rnb, rl.rail_idx, s.n_ports);
+                            rx_off = rst.off;
+                            rx_len = rst.len;
+                            rx_total_pkts = if (rx_len == 0) 0 else @intCast((rx_len + max_payload - 1) / max_payload);
+                            if (rx_total_pkts == 0) {
+                                rx_done = true;
+                            } else {
+                                rx_mode = .ddp;
+                                cacheInvalRange(recv_slot_va + rx_off, rx_len);
+                                rx_win_start = 0;
+                                rx_win_pkts = @min(bulk_win_max_pkts, rx_total_pkts);
+                                rx_cts_gen = 1;
+                                rl.in_ddp_rx = true;
+                                rl.ddp_rx_win_start = 0;
+                                rl.ddp_rx_acked = false;
+                                rl.data_q.postDdpRx(recv_slot_iova + rx_off, rx_win_pkts);
+                                rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                    .opcode = @intFromEnum(Op.cts),
+                                    .seq = seq32,
+                                    .win_start = 0,
+                                    .win_pkts = @intCast(rx_win_pkts),
+                                    .nbytes = rnb,
+                                    .cts_gen = rx_cts_gen,
+                                });
+                                last_cts_tx = t_now;
+                                last_rx_activity = t_now;
+                            }
+                        } else if (rl.eager_rx[slot].seq == seq32) {
+                            rx_mode = .eager;
+                        } else if (t_now - last_eager_req_tx >= 500_000) {
+                            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                .opcode = @intFromEnum(Op.eager_req),
+                                .seq = seq32,
+                            });
+                            last_eager_req_tx = t_now;
+                        }
+                    },
+                    .eager => {
+                        const es = &rl.eager_rx[slot];
+                        if (es.seq == seq32 and es.done()) {
+                            const rst = stripeFor(es.nbytes, rl.rail_idx, s.n_ports);
+                            if (rst.len > 0) cacheCleanRange(recv_slot_va + rst.off, rst.len);
+                            rx_done = true;
+                        } else if (t_now - last_eager_req_tx >= 500_000) {
+                            rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                .opcode = @intFromEnum(Op.eager_req),
+                                .seq = seq32,
+                            });
+                            last_eager_req_tx = t_now;
+                        }
+                    },
+                    .ddp => {
+                        const win_off = @as(u64, rx_win_start) * max_payload;
+                        const rx_win_iova = recv_slot_iova + rx_off + win_off;
+                        if (rx_draining) {
+                            while (rl.data_q.pollDataRx()) |_| {
+                                drained_any = true;
+                                rx_drain_since = nowNs();
+                                last_rx_activity = rx_drain_since;
+                            }
+                            const avail: u32 = rl.data_q.rx_prod -% rl.data_q.rx_cons;
+                            if (avail < 32 and avail + 64 + rx_win_pkts < uapi.ring_desc_cnt - 16) {
+                                rl.data_q.postDdpDrain(rx_win_iova, 64);
+                            }
+                            const t_d = nowNs();
+                            if ((t_d - rx_drain_since) >= 1_000_000) {
+                                const rem: u32 = rl.data_q.rx_prod -% rl.data_q.rx_cons;
+                                if (rem + rx_win_pkts < uapi.ring_desc_cnt - 16) {
+                                    rx_draining = false;
+                                    rx_skip = rem;
+                                    rx_got = 0;
+                                    rx_gap = false;
+                                    rx_cts_gen +%= 1;
+                                    rl.retrans_cnt += 1;
+                                    rl.data_q.postDdpRx(rx_win_iova, rx_win_pkts);
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.nack),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rem),
+                                        .cts_gen = rx_cts_gen,
+                                    });
+                                    last_rx_activity = t_d;
+                                }
+                            }
+                        } else {
+                            while (rx_skip > 0 or rx_got < rx_win_pkts) {
+                                const comp = rl.data_q.pollDataRx() orelse break;
+                                drained_any = true;
+                                last_rx_activity = nowNs();
+                                if (rx_skip > 0) {
+                                    rx_skip -= 1;
+                                    continue;
+                                }
+                                if (comp.err or comp.hdr.seq != seq32 or comp.hdr.win_start != rx_win_start or comp.hdr.cts_gen != rx_cts_gen or comp.hdr.psn != rx_got) {
+                                    rx_gap = true;
+                                }
+                                rx_got += 1;
+                            }
+                            if (rx_skip == 0 and rx_got == rx_win_pkts) {
+                                if (!rx_gap) {
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.ack),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rx_win_pkts),
+                                    });
+                                    rl.ddp_rx_acked = true;
+                                    rx_win_start += rx_win_pkts;
+                                    if (rx_win_start >= rx_total_pkts) {
+                                        cacheInvalRange(recv_slot_va + rx_off, rx_len);
+                                        rx_done = true;
+                                    } else {
+                                        rx_win_pkts = @min(bulk_win_max_pkts, rx_total_pkts - rx_win_start);
+                                        rx_got = 0;
+                                        rx_skip = 0;
+                                        rx_gap = false;
+                                        rx_cts_gen +%= 1;
+                                        rl.ddp_rx_win_start = rx_win_start;
+                                        rl.ddp_rx_acked = false;
+                                        const next_off = @as(u64, rx_win_start) * max_payload;
+                                        rl.data_q.postDdpRx(recv_slot_iova + rx_off + next_off, rx_win_pkts);
+                                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                            .opcode = @intFromEnum(Op.cts),
+                                            .seq = seq32,
+                                            .win_start = rx_win_start,
+                                            .win_pkts = @intCast(rx_win_pkts),
+                                            .cts_gen = rx_cts_gen,
+                                        });
+                                        last_cts_tx = nowNs();
+                                        last_rx_activity = last_cts_tx;
+                                    }
+                                } else {
+                                    rx_draining = true;
+                                    rx_drain_since = nowNs();
+                                    rx_got = 0;
+                                    rx_gap = false;
+                                    if (rl.data_q.rx_prod -% rl.data_q.rx_cons + 64 + rx_win_pkts < uapi.ring_desc_cnt - 16) {
+                                        rl.data_q.postDdpDrain(rx_win_iova, 64);
+                                    }
+                                    last_rx_activity = rx_drain_since;
+                                }
+                            }
+                        }
+
+                        // RX DDP retry / stall timers (only while still receiving a window)
+                        if (!rx_done and !rx_draining) {
+                            const tr = nowNs();
+                            if (rx_skip == 0 and rx_got == 0 and (tr - last_cts_tx) >= 1_000_000) {
+                                const rem: u32 = rl.data_q.rx_prod -% rl.data_q.rx_cons;
+                                if (@as(i32, @bitCast(rl.peer_max_seq -% seq32)) >= 0 and (tr - last_rx_activity) >= 50_000_000 and
+                                    rem + rx_win_pkts < uapi.ring_desc_cnt - 16)
+                                {
+                                    rx_skip = rem;
+                                    rx_got = 0;
+                                    rx_gap = false;
+                                    rx_cts_gen +%= 1;
+                                    rl.retrans_cnt += 1;
+                                    rl.data_q.postDdpRx(rx_win_iova, rx_win_pkts);
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.nack),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rem),
+                                        .cts_gen = rx_cts_gen,
+                                    });
+                                    last_rx_activity = tr;
+                                    last_cts_tx = tr;
+                                } else {
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.cts),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rx_win_pkts),
+                                        .cts_gen = rx_cts_gen,
+                                    });
+                                    last_cts_tx = tr;
+                                }
+                            }
+                            if ((rx_skip > 0 or (rx_got > 0 and rx_got < rx_win_pkts)) and !drained_any and (tr - last_rx_activity) >= 5_000_000) {
+                                const rem: u32 = rl.data_q.rx_prod -% rl.data_q.rx_cons;
+                                if (rem + rx_win_pkts < uapi.ring_desc_cnt - 16) {
+                                    rx_skip = rem;
+                                    rx_got = 0;
+                                    rx_gap = false;
+                                    rx_cts_gen +%= 1;
+                                    rl.retrans_cnt += 1;
+                                    rl.data_q.postDdpRx(rx_win_iova, rx_win_pkts);
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.nack),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rem),
+                                        .cts_gen = rx_cts_gen,
+                                    });
+                                } else if (rx_skip > 0 and rx_got == 0) {
+                                    rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                                        .opcode = @intFromEnum(Op.nack),
+                                        .seq = seq32,
+                                        .win_start = rx_win_start,
+                                        .win_pkts = @intCast(rx_skip),
+                                        .cts_gen = rx_cts_gen,
+                                    });
+                                }
+                                last_rx_activity = tr;
+                            }
+                        }
+                    },
+                }
+            }
+
+            // 2. Progress TX DDP side.
+            if (!tx_done) {
+                if (rl.stashed_cts.valid and rl.stashed_cts.seq == seq32 and rl.stashed_cts.win_start == tx_win_start) {
+                    if (!tx_allowed or rl.stashed_cts.cts_gen != peer_cts_gen) {
+                        peer_cts_gen = rl.stashed_cts.cts_gen;
+                        tx_allowed = true;
+                        tx_sent = 0;
+                        tx_flush = 0;
+                    }
+                    rl.stashed_cts.valid = false;
+                }
+                if (rl.has_stashed_ack and rl.stashed_ack_seq == seq32 and rl.stashed_ack_win == tx_win_start) {
+                    if (tx_sent == tx_win_pkts) {
+                        tx_acked = true;
+                    } else {
+                        std.log.warn("mgbe_zc port {d} seq {d}: ignoring premature ACK (tx_sent={d}/{d} tx_allowed={})", .{ rl.port, seq32, tx_sent, tx_win_pkts, tx_allowed });
+                    }
+                    rl.has_stashed_ack = false;
+                }
+                if (rl.has_stashed_nack and rl.stashed_nack_seq == seq32 and rl.stashed_nack_win == tx_win_start) {
+                    if (rl.stashed_nack_gen != peer_cts_gen) {
+                        peer_cts_gen = rl.stashed_nack_gen;
+                        tx_flush = rl.stashed_nack_flush;
+                        tx_sent = 0;
+                        tx_allowed = true;
+                        rl.retrans_cnt += 1;
+                    }
+                    rl.has_stashed_nack = false;
+                }
+                if (!tx_acked and tx_sent == tx_win_pkts and (@as(i32, @bitCast(rl.peer_max_seq -% seq32)) > 0 or
+                    (rl.stashed_cts.valid and rl.stashed_cts.seq == seq32 and rl.stashed_cts.win_start > tx_win_start)))
+                {
+                    tx_acked = true;
+                }
+
+                if (tx_acked) {
+                    tx_win_start += tx_win_pkts;
+                    if (tx_win_start >= tx_total_pkts) {
+                        tx_done = true;
+                    } else {
+                        tx_win_pkts = @min(bulk_win_max_pkts, tx_total_pkts - tx_win_start);
+                        tx_allowed = false;
+                        tx_sent = 0;
+                        tx_flush = 0;
+                        tx_acked = false;
+                        peer_cts_gen = 0;
+                        last_ack_req_tx = nowNs();
+                    }
+                } else {
+                    if (tx_allowed and (tx_flush > 0 or tx_sent < tx_win_pkts)) {
+                        var sent_now: u32 = 0;
+                        while (tx_flush > 0 and sent_now < tx_batch_pkts) {
+                            const ring_db = (sent_now + 1 == tx_batch_pkts) or (tx_flush == 1 and tx_sent == tx_win_pkts);
+                            rl.data_q.sendGather(
+                                uapi.ethtype_data,
+                                rl.local_mac,
+                                rl.peer_mac,
+                                .{
+                                    .opcode = @intFromEnum(Op.bulk_data),
+                                    .seq = seq32,
+                                    .win_start = tx_win_start,
+                                    .psn = 0xFFFFFFFF,
+                                    .win_pkts = @intCast(tx_win_pkts),
+                                    .nbytes = tx_nbytes,
+                                    .cts_gen = peer_cts_gen,
+                                },
+                                send_iova,
+                                16,
+                                ring_db,
+                            );
+                            tx_flush -= 1;
+                            sent_now += 1;
+                        }
+                        while (tx_flush == 0 and tx_sent < tx_win_pkts and sent_now < tx_batch_pkts) {
+                            const global_p = tx_win_start + tx_sent;
+                            const po = @as(usize, global_p) * max_payload;
+                            const plen: u32 = @intCast(@min(max_payload, tx_len - po));
+                            const ring_db = (sent_now + 1 == tx_batch_pkts) or (tx_sent + 1 == tx_win_pkts);
+                            rl.data_q.sendGather(
+                                uapi.ethtype_data,
+                                rl.local_mac,
+                                rl.peer_mac,
+                                .{
+                                    .opcode = @intFromEnum(Op.bulk_data),
+                                    .seq = seq32,
+                                    .win_start = tx_win_start,
+                                    .psn = tx_sent,
+                                    .win_pkts = @intCast(tx_win_pkts),
+                                    .nbytes = tx_nbytes,
+                                    .cts_gen = peer_cts_gen,
+                                },
+                                send_iova + po,
+                                plen,
+                                ring_db,
+                            );
+                            tx_sent += 1;
+                            sent_now += 1;
+                        }
+                        if (tx_sent == tx_win_pkts) last_ack_req_tx = nowNs();
+                    }
+                    const tt = nowNs();
+                    if (!tx_allowed and tx_win_start == 0 and (tt - last_rts_tx) >= 500_000) {
+                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                            .opcode = @intFromEnum(Op.rts),
+                            .seq = seq32,
+                            .nbytes = tx_nbytes,
+                        });
+                        last_rts_tx = tt;
+                    }
+                    if (tx_allowed and tx_sent == tx_win_pkts and (tt - last_ack_req_tx) >= 2_000_000) {
+                        rl.ctrl_q.sendCtrlHdr(rl.local_mac, rl.peer_mac, .{
+                            .opcode = @intFromEnum(Op.ack_req),
+                            .seq = seq32,
+                            .win_start = tx_win_start,
+                            .win_pkts = @intCast(tx_win_pkts),
+                        });
+                        last_ack_req_tx = tt;
+                    }
+                }
+            }
+
+            // 3. Peer arrival & timeout checks.
+            const t = nowNs();
+            if (!peer_seen and @as(i32, @bitCast(rl.peer_max_seq -% seq32)) >= 0) {
+                peer_seen = true;
+                t_xfer = t;
+                last_rx_activity = t;
+            }
+            const timed_out = if (peer_seen) (t - t_xfer >= s.timeout_ns) else (t - t_start >= s.arrival_timeout_ns);
+            if (timed_out) {
+                std.log.err(
+                    "mgbe_zc timeout port {d} DDP seq {d} (rx_mode={s} rx_done={} rx={d}/{d} win={d} skip={d} drain={} tx_done={} tx={d}/{d} win={d} allowed={} peer_max_seq={d} peer_seen={} retrans={d})",
+                    .{ rl.port, seq32, @tagName(rx_mode), rx_done, rx_got, rx_win_pkts, rx_win_start, rx_skip, rx_draining, tx_done, tx_sent, tx_win_pkts, tx_win_start, tx_allowed, rl.peer_max_seq, peer_seen, rl.retrans_cnt },
+                );
+                rl.ctrl_q.dumpState("ctrl_q");
+                rl.data_q.dumpState("data_q");
+                s.noteErr("port {d} DDP seq {d} timed out (rx_done={} tx_done={} retrans={d})", .{ rl.port, seq32, rx_done, tx_done, rl.retrans_cnt });
+                return error.ProxyFailed;
+            }
+        }
+        rl.ddp_cnt += 1;
+    }
+
+    fn publishDone(s: *State, q: u64) void {
+        const slot: usize = @intCast(q & s.slot_mask);
+        const prev = s.arrived[slot].fetchAdd(1, .acq_rel);
+        if (prev + 1 == s.n_ports) {
+            s.arrived[slot].store(0, .monotonic);
+            // Publish sent[slot] before flagAt(q, peer) so the next stage(q + slots) always sees sent >= q.
+            @atomicStore(u64, &s.sent()[slot], q, .release);
+            @atomicStore(u64, s.flagAt(q, 1 - s.rank), q, .release);
+        }
+    }
+
+    fn railWorker(s: *State, rail_idx: usize) void {
+        const rl = &s.rails[rail_idx];
+        placeRailWorker(rail_idx, rl.pin_cpu);
+        const naps = s.idle_ns > 0;
+        if (naps and comptime builtin.os.tag == .linux) _ = prctl(pr_set_timerslack, 1000, 0, 0, 0);
+        var quiet: u64 = 0;
+        var quiet_since: u64 = nowNs();
+        var drowsy = false;
+
+        while (s.running.load(.monotonic)) {
+            if (s.aborted()) break;
+            const rx_busy = s.drainCtrlRx(rl);
+            const ring_seq = @atomicLoad(u64, s.doorbell(), .acquire);
+            if (ring_seq == rl.last_seq) {
+                if (rx_busy) {
+                    drowsy = false;
+                    quiet = 0;
+                    continue;
+                }
+                quiet += 1;
+                if ((quiet & 63) == 0) {
+                    rl.ctrl_q.reclaimTx();
+                    rl.data_q.reclaimTx();
+                }
+                if (!naps) continue;
+                if (drowsy) {
+                    nap(s.nap_ns);
+                    continue;
+                }
+                if (quiet == 1) {
+                    quiet_since = nowNs();
+                } else if ((quiet & 1023) == 0 and nowNs() -% quiet_since > s.idle_ns) {
+                    drowsy = true;
+                }
+                continue;
+            }
+            drowsy = false;
+            quiet = 0;
+
+            if (ring_seq < rl.last_seq or ring_seq - rl.last_seq > s.slots) {
+                s.noteErr("port {d}: doorbell skipped ({d} -> {d})", .{ rl.port, rl.last_seq, ring_seq });
+                s.reportFailure();
+                break;
+            }
+            var q = rl.last_seq + 1;
+            while (q <= ring_seq) : (q += 1) {
+                const slot: usize = @intCast(q & s.slot_mask);
+                const nb64 = @atomicLoad(u64, &s.sizes()[slot], .acquire);
+                if (nb64 % 16 != 0 or nb64 > s.layout.slot_bytes) {
+                    s.noteErr("port {d}: bad shard size {d} at seq {d}", .{ rl.port, nb64, q });
+                    s.reportFailure();
+                    break;
+                }
+                s.runExchange(rl, q, @intCast(nb64)) catch {
+                    s.reportFailure();
+                    break;
+                };
+                rl.last_seq = q;
+                rl.last_seq32 = @truncate(q);
+                s.publishDone(q);
+            }
+            if (s.aborted()) break;
+        }
+
+        // Keep draining ctrl_q until teardown so peer retries never back up the MAC RX FIFO
+        // (which would otherwise starve VDMA 0/1 TCP/liveness/SSH on the shared port).
+        while (s.running.load(.monotonic)) {
+            while (rl.ctrl_q.peekCtrl()) |_| rl.ctrl_q.consumeCtrl();
+            nap(100_000);
+        }
+    }
+};
+
+test "mgbe_zc Layout aligns send, recv and meta cleanly for dsv41 Ring" {
+    const l = try Layout.of(2, 20 << 20);
+    try std.testing.expectEqual(@as(usize, 0), l.send_off);
+    try std.testing.expectEqual(@as(usize, 20 << 20), l.slot_bytes);
+    try std.testing.expectEqual(@as(usize, 0), l.recv_off % Layout.section_align);
+    try std.testing.expectEqual(@as(usize, 0), l.meta_off % Layout.section_align);
+    try std.testing.expect(l.send_off + l.send_len <= l.recv_off);
+    try std.testing.expect(l.recv_off + l.recv_len <= l.meta_off);
+    try std.testing.expectEqual(l.send_off + l.slot_bytes, l.sendAt(1));
+    try std.testing.expectEqual(l.recv_off + 3 * l.slot_bytes, l.recvAt(1, 1));
+    try std.testing.expectError(error.BadLayout, Layout.of(1, 4096));
+    try std.testing.expectError(error.BadLayout, Layout.of(3, 4096));
+}
+
+test "mgbe_zc stripeFor covers every byte without overlap including 0 and uneven sizes" {
+    for ([_]usize{ 0, 16, 48, 64, 4096, 32768, 131072, (16 << 20) - 16, 20 << 20 }) |nb| {
+        for ([_]usize{ 1, 2, 4 }) |np| {
+            var total: usize = 0;
+            for (0..np) |r| {
+                const st = stripeFor(nb, r, np);
+                try std.testing.expectEqual(total, st.off);
+                try std.testing.expectEqual(@as(usize, 0), st.len % 16);
+                total += st.len;
+            }
+            try std.testing.expectEqual(nb, total);
+        }
+    }
+}
+
+test "mgbe_zc EagerSlot handles 0-packet and multi-packet completions" {
+    var z: EagerSlot = .{ .seq = 1, .mask = 0, .total_pkts = 0, .nbytes = 0 };
+    try std.testing.expect(!z.done());
+    z.mask = 1;
+    try std.testing.expect(z.done());
+
+    var m: EagerSlot = .{ .seq = 2, .mask = 0, .total_pkts = 4, .nbytes = 32768 };
+    try std.testing.expect(!m.done());
+    m.mask = 0b0111;
+    try std.testing.expect(!m.done());
+    m.mask = 0b1111;
+    try std.testing.expect(m.done());
+}
+
+test "mgbe_zc Info is an extern struct safe for wire exchange" {
+    try std.testing.expectEqual(@as(usize, 64), @sizeOf(Info));
+}
