+    /// TP2's /dev/mgbe_zc 4x25GbE zero-copy ring (Jetson AGX Thor): both ranks open, exchange port MACs over NCCL,
+    /// run the L2 ctrl+DDP probe, and agree before starting workers; if either rank cannot bring it up, both fall back
+    /// cleanly to NCCL.
+    pub fn openMgbeZcRing(gpa: std.mem.Allocator, d: *const cuda.Driver, k: rdma.Kernels, rank: u32, comm: *const comm_mod.Comm, stream: cuda.Stream) !?*rdma.Ring {
+        if (comm.world != 2) return null;
+        const max_bytes = rdma.mgbe_zc.maxBytesFromEnv();
+        var r_opt: ?*rdma.Ring = rdma.Ring.createMgbeZc(gpa, d, k, rank, .{
+            .slots = rdma.mgbe_zc.default_slots,
+            .max_bytes = max_bytes,
+        }) catch |e| blk: {
+            std.log.warn("dsv41: mgbe_zc ring setup skipped ({s}); NCCL carries every gather", .{@errorName(e)});
+            break :blk null;
+        };
+        errdefer if (r_opt) |r| r.destroy(gpa);
+
+        const per = @sizeOf(rdma.mgbe_zc.Info);
+        const mine: rdma.mgbe_zc.Info = if (r_opt) |r| r.zcInfo() else .{};
+        var dev = try cuda.DeviceBuffer.alloc(d, 3 * per);
+        defer dev.free();
+        try dev.upload(0, std.mem.asBytes(&mine));
+        try comm.allGather(dev.ptr, dev.ptr + per, per, .u8, stream);
+        try stream.synchronize();
+        var all: [2]rdma.mgbe_zc.Info = undefined;
+        try dev.download(per, std.mem.sliceAsBytes(&all));
+
+        const peer_info = all[1 - rank];
+        if (r_opt == null or peer_info.ok == 0 or peer_info.n_ports != mine.n_ports or peer_info.slot_bytes != mine.slot_bytes) {
+            if (r_opt) |r| {
+                r.destroy(gpa);
+                r_opt = null;
+            }
+            return null;
+        }
+        const r = r_opt.?;
+        r.connectMgbeZc(peer_info) catch |e| {
+            std.log.warn("dsv41: mgbe_zc ring connect failed ({s}); NCCL carries every gather", .{@errorName(e)});
+            r.destroy(gpa);
+            r_opt = null;
+            return null;
+        };
+
+        // Barrier so both ranks have queues started and peer MACs loaded before probing the wire.
+        try comm.allGather(dev.ptr, dev.ptr + per, 1, .u8, stream);
+        try stream.synchronize();
+
+        const verdict: u8 = blk: {
+            r.probeMgbeZc() catch |e| {
+                std.log.err("dsv41: mgbe_zc wire probe failed ({s}: {s})", .{ @errorName(e), r.zcLastErr() });
+                break :blk 0;
+            };
+            break :blk 1;
+        };
+        try dev.upload(0, &[_]u8{verdict});
+        try comm.allGather(dev.ptr, dev.ptr + per, 1, .u8, stream);
+        try stream.synchronize();
+        var verdicts: [2]u8 = .{ 0, 0 };
+        try dev.download(per, &verdicts);
+        if (verdicts[0] == 0 or verdicts[1] == 0) {
+            std.log.warn("dsv41: mgbe_zc wire probe failed on a rank; NCCL carries every gather", .{});
+            r.destroy(gpa);
+            r_opt = null;
+            return null;
+        }
+        try r.start();
+        std.log.info("dsv41: mgbe_zc ring active (2 ranks, {d} rail(s), slots up to {d} KiB)", .{ r.zcPorts(), r.s.max_bytes >> 10 });
+        return r;
+    }
+
     fn readKit(a: std.mem.Allocator, io: std.Io, kit: []const u8, name: []const u8) ![]const u8 {
